<script>
  const tracks = Array.from(document.querySelectorAll<HTMLElement>('.career-track'));
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  let queued = false;
  function update() {
    for (const track of tracks) {
      const rect = track.getBoundingClientRect();
      const progress = reduced.matches ? 1 : Math.max(0, Math.min(1, (innerHeight * .6 - rect.top) / rect.height));
      track.style.setProperty('--career-progress', String(progress));
      const entries = Array.from(track.querySelectorAll<HTMLElement>('[data-career-entry]'));
      let active: HTMLElement | undefined;
      for (const entry of entries) {
        if (entry.getBoundingClientRect().top < innerHeight * .65) active = entry;
        entry.removeAttribute('data-current');
      }
      active?.setAttribute('data-current', '');
    }
    queued = false;
  }
  const schedule = () => { if (!queued && tracks.length) { queued = true; requestAnimationFrame(update); } };
  addEventListener('scroll', schedule, { passive: true });
  addEventListener('resize', schedule);reduced.addEventListener('change', schedule);update();
</script>
