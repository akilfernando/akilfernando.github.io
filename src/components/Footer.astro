---
import { site, socials } from '../config';
const year = new Date().getFullYear();
---
<footer class="footer shell">
  <div class="links">
    {socials.map((s) => <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>)}
  </div>
  <div class="copy">&copy; {year} {site.name}</div>

  {/* Retro-only furniture. Hidden unless the alien toggle is on. */}
  <div class="retro-only retro-badges">
    <span class="retro-badge blink">UNDER CONSTRUCTION</span>
    <span class="retro-badge">HTML 4.01</span>
    <span class="retro-badge">NO FRAMES</span>
    <span>Visitors:</span>
    <span class="retro-counter" id="retro-counter">000000</span>
    <span>(yours only, counted right here in your browser)</span>
  </div>
</footer>

<script is:inline>
  (function () {
    var el = document.getElementById('retro-counter');
    if (!el) return;
    var n = 1;
    try {
      n = (parseInt(localStorage.getItem('retro-visits'), 10) || 0) + 1;
      localStorage.setItem('retro-visits', String(n));
    } catch (e) { /* storage blocked, stay at one */ }
    el.textContent = String(n).padStart(6, '0');
  })();
</script>

<style>
  .footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-block: var(--space-3) var(--space-6);
    border-top: 1px solid var(--rule);
  }
  .links { display: flex; gap: var(--space-3); flex-wrap: wrap; }
  .links a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
    text-decoration: none;
  }
  .links a:hover { color: var(--cobalt); }
  .copy {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: #a8a293;
  }
</style>
