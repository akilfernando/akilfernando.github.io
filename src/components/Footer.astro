---
import RetroToggle from './RetroToggle.astro';
import { site, socials } from '../config';
const year = new Date().getFullYear();
const archive = [{ label: 'Technical notes', href: '/blog' }, { label: 'Prototypes', href: '/prototypes' }, { label: 'Creative writing', href: '/writing' }, { label: 'Reading & playing', href: '/log' }];
---
<footer class="footer shell"><div class="footer-top"><div class="footer-note"><p class="overline">Elsewhere on this site</p><p>Beyond the projects.</p></div><nav aria-label="More from Akil">{archive.map((s) => <a href={s.href}>{s.label}</a>)}</nav><nav aria-label="Find Akil online">{socials.map((s) => <a href={s.href}>{s.label}<span aria-hidden="true"> ↗</span></a>)}</nav></div><div class="footer-bottom"><p>&copy; {year} {site.name}</p><RetroToggle /><a href="/rss.xml">Subscribe via RSS</a></div></footer>
<style>
  .footer { padding-top: 2.5rem; padding-bottom: 1.5rem; }
  .footer-top { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 2rem; padding-block: 2.5rem 3.5rem; border-top: 1px solid var(--ink); }
  .footer-note > p:last-child { font-family: var(--font-display); font-size: 1.5rem; line-height: 1.25; margin-top: 1rem; letter-spacing: -.025em; }
  nav { display: flex; flex-direction: column; gap: .65rem; align-items: flex-start; }
  nav a { min-height: 32px; display: inline-flex; align-items: center; gap: .3rem; font-size: .8rem; color: var(--ink-muted); text-decoration: none; }
  nav a:hover { color: var(--accent); text-decoration: underline; }
  .footer-bottom { border-top: 1px solid var(--rule); padding-top: 1.25rem; display: flex; justify-content: space-between; flex-wrap: wrap; gap: .75rem 1.5rem; font-family: var(--font-mono); font-size: .675rem; color: var(--ink-muted); }
  .footer-bottom a { padding-block: .5rem; }
  @media (max-width: 600px) { .footer-top { grid-template-columns: 1fr 1fr; gap: 2rem 1rem; padding-top: 2rem; } .footer-note { grid-column: 1 / -1; } .footer-bottom > p:nth-child(2) { display: none; } }
</style>
