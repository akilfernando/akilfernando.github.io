---
import ThemeControl from './ThemeControl.astro';
import { site, sections } from '../config';
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="masthead shell">
  <a class="wordmark" href="/" aria-label={`${site.name}, home`}><span class="monogram" aria-hidden="true">af<span>.</span></span><span class="wordmark-name">Akil Fernando</span></a>
  <nav aria-label="Primary">{sections.map((s) => <a href={s.href} aria-current={pathname === s.href || pathname.startsWith(s.href + '/') ? 'page' : undefined}>{s.label}</a>)}</nav><ThemeControl />
</header>
<style>
  .masthead { display: flex; justify-content: space-between; align-items: center; gap: 2rem; padding-block: 1.8rem; position: relative; }
  .masthead::after { content: ''; position: absolute; bottom: 0; left: clamp(1.25rem, 4.5vw, 4rem); right: clamp(1.25rem, 4.5vw, 4rem); height: 1px; background: var(--rule); }
  .wordmark { display: flex; align-items: center; gap: 1rem; text-decoration: none; white-space: nowrap; }
  .monogram { font-family: var(--font-display); font-weight: 500; font-size: 2rem; line-height: 1; letter-spacing: -.08em; }
  .monogram span { color: var(--accent); }
  .wordmark:hover .wordmark-name { text-decoration: underline; text-underline-offset: .3em; }
  .wordmark-name { font-size: .8rem; letter-spacing: -.015em; }
  nav { display: flex; gap: 2rem; margin-left: auto; }
  nav a { font-size: .8rem; text-decoration: none; color: var(--ink-muted); padding-block: .7rem; min-height: 44px; display: inline-flex; align-items: center; position: relative; }
  nav a:hover, nav a[aria-current] { color: var(--accent); }
  nav a:hover::after, nav a:focus-visible::after, nav a[aria-current]::after { content: ''; position: absolute; bottom: 0; left: 0; width: 100%; height: 1px; background: var(--accent); }
  @media (max-width: 900px) { .masthead { padding-block: 1.25rem; gap: 1rem; flex-wrap: wrap; } nav { gap: 1.4rem; order: 3; width: 100%; margin-left: 0; justify-content: space-between; } }
  @media (max-width: 430px) { .wordmark:hover .wordmark-name { text-decoration: underline; text-underline-offset: .3em; }
  .wordmark-name { display: none; } nav { gap: 1rem; } nav a { font-size: .75rem; } }
</style>
