---
import { site, sections } from '../config';

const pathname = new URL(Astro.request.url).pathname;
---
<header class="masthead shell">
  <a class="wordmark" href="/">{site.name}</a>
  <nav class="navlinks" aria-label="Primary">
    {sections.map((s) => {
      const isActive = pathname === s.href || (s.href !== '/' && pathname.startsWith(s.href + '/'));
      return (
        <a
          href={s.href}
          aria-current={isActive ? 'page' : undefined}
        >
          {s.label}
        </a>
      );
    })}
  </nav>
</header>

<style>
  .masthead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-block: var(--space-3) 0;
    gap: var(--space-3);
  }
  .wordmark {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 500;
    font-size: 1.0625rem;
    text-decoration: none;
  }
  .navlinks { display: flex; gap: var(--space-3); flex-wrap: wrap; }
  .navlinks a {
    font-size: 0.8125rem;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .navlinks a:hover { color: var(--cobalt); }
  .navlinks a[aria-current="page"] {
    color: var(--ink);
    font-weight: 500;
  }
  /* On phones, drop the nav onto its own line and give links tappable height. */
  @media (max-width: 620px) {
    .masthead { flex-wrap: wrap; row-gap: var(--space-2); }
    .navlinks { gap: var(--space-3); width: 100%; }
    .navlinks a { padding: 4px 0; }
  }
</style>
