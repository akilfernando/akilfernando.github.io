---
interface Props { category: string; slug: string }
const { category, slug } = Astro.props;
---
<svg class:list={['project-mark', `mark-${category}`, `mark-${slug}`]} viewBox="0 0 100 80" aria-hidden="true" focusable="false">
  {slug === 'ci-diagnostic-prototypes' ? <g class="bars">{[26,45,34,58,40,20].map((h,i)=><path style={`--i:${i}`} d={`M${15+i*13} 68V${68-h}`} />)}</g> : category === 'game' ? <><g class="cube-mark"><path d="M50 10 85 29 50 49 15 29Z"/><path d="M15 29V58L50 77 85 58V29M50 49V77"/></g><path class="axis" d="M4 68H26M15 57V79"/></> : category === 'security' ? <><path class="shield" d="M50 7 80 18V39C80 54 67 67 50 75 33 67 20 54 20 39V18Z"/><path class="check" d="m35 40 10 10 22-24"/></> : category === 'academic' ? <><circle class="orbit-one" cx="50" cy="41" r="28"/><ellipse class="orbit-two" cx="50" cy="41" rx="39" ry="13" transform="rotate(-35 50 41)"/><circle cx="50" cy="41" r="4"/></> : <><path class="paper-back" d="M25 12H77V66H25Z"/><g class="paper-front"><path d="M16 20H68V74H16Z"/><path class="paper-line" d="M27 36H56M27 45H56M27 54H49"/><path class="ink-stroke" d="M26 44H58"/></g></>}
</svg>
<style>
.project-mark { width: 78px; height: 66px; margin-top: 1.4rem; color: var(--accent); overflow: visible; fill: none; stroke: currentColor; stroke-width: 1; opacity: .65; transition: opacity .3s; }.cube-mark,.paper-front { transform-origin: 50% 50%; transition: transform .6s cubic-bezier(.2,.7,.3,1); }.cube-mark path:first-child,.paper-front path:first-child { fill: var(--paper); }.axis { opacity: .4; }.paper-back { fill: var(--accent-tint); }.paper-line { stroke: var(--ink-muted); }.ink-stroke { stroke-width: 8; opacity: 0; stroke: #cfb747; stroke-dasharray: 32; stroke-dashoffset: 32; transition: stroke-dashoffset .5s,opacity .3s; }.check { stroke-width: 2; stroke-dasharray: 50; stroke-dashoffset: 50; transition: stroke-dashoffset .6s; }.orbit-two { transform-origin: 50px 41px; transition: transform .7s; }.bars path { stroke-width: 6; transform-origin: center 68px; transition: transform .5s; transition-delay: calc(var(--i) * 30ms); }
:global(.project:hover) .project-mark,:global(.project:focus-within) .project-mark { opacity: 1; }:global(.project:hover) .cube-mark,:global(.project:focus-within) .cube-mark { transform: translateY(-5px) rotate(-8deg); }:global(.project:hover) .paper-front,:global(.project:focus-within) .paper-front { transform: translate(-3px,3px); }:global(.project:hover) .ink-stroke,:global(.project:focus-within) .ink-stroke { opacity: .45; stroke-dashoffset: 0; }:global(.project:hover) .check,:global(.project:focus-within) .check { stroke-dashoffset: 0; }:global(.project:hover) .orbit-two,:global(.project:focus-within) .orbit-two { transform: rotate(35deg); }:global(.project:hover) .bars path,:global(.project:focus-within) .bars path { transform: scaleY(.6); }
@media(max-width:800px) { .project-mark { width: 28px; height: 32px; margin-top: .7rem; } }
@media(prefers-reduced-motion:reduce) { .cube-mark,.paper-front,.orbit-two,.bars path { transform: none !important; } }
</style>
