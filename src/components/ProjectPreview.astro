---
interface Props { kind: 'openquire' | 'ruster' }
const { kind } = Astro.props;
---
<figure aria-label={kind === 'openquire' ? 'OpenQuire document tools' : 'Ruster scene'} class:list={['project-preview', kind]} data-preview={kind}>
  <div class="window-bar"><span class="window-dots" aria-hidden="true">● ● ●</span><span>{kind === 'openquire' ? 'OpenQuire / document tools' : 'Ruster / scene tools'}</span></div>
  {kind === 'openquire' ? <>
    <div class="document-desk">
      <div class="document-rail" aria-hidden="true"><span>01</span><div></div><span>02</span><div></div></div>
      <div class="document-sheet"><p class="doc-label">FIELD NOTES / 001</p><h3>A document,<br />on your device.</h3><div class="doc-rule"></div><p class="doc-text">A few notes about <span class="marked">working with documents</span>, keeping things organized, and making room for the next draft.</p><p class="doc-text">Send a copy to <span class="private-text">alex@example.com</span> when it’s ready.</p><div class="doc-lines" aria-hidden="true"><i></i><i></i><i></i></div><span class="margin-note" aria-hidden="true">Review this passage ↙</span><p class="doc-page">OPENQUIRE <span>1 / 2</span></p></div>
    </div>
    <div class="word-tools"><div class="tool-buttons" role="group" aria-label="Preview document tools"><button type="button" data-word-tool="highlight"><span>Highlight</span></button><button type="button" data-word-tool="redact"><span>Redact</span></button><button type="button" data-word-tool="underline"><span>Underline</span></button></div></div>
  </> : <>
    <div class="scene-desk"><div class="scene-label" aria-hidden="true">PERSPECTIVE <span>X / Y / Z</span></div><div class="scene-stage" aria-hidden="true"><div class="scene-world"><div class="floor"></div>{[0,1,2].map(i => <div class={`cube cube-${i}`}><i class="face front"></i><i class="face back"></i><i class="face right"></i><i class="face left"></i><i class="face top"></i><i class="face bottom"></i></div>)}</div></div><div class="scene-origin" aria-hidden="true">+ <span>Scene origin</span></div></div>
  </>}
</figure>
<script>
  for (const preview of document.querySelectorAll<HTMLElement>('[data-preview="openquire"]')) {
    for (const button of preview.querySelectorAll<HTMLButtonElement>('[data-word-tool]')) {
      const activate = () => { preview.dataset.tool = button.dataset.wordTool; };
      button.addEventListener('pointerenter', activate);
      button.addEventListener('focus', activate);
      button.addEventListener('click', activate);
      button.addEventListener('pointerleave', () => { if (document.activeElement !== button) delete preview.dataset.tool; });
      button.addEventListener('blur', () => { delete preview.dataset.tool; });
    }
  }
</script>
<style>
.project-preview { --orbit: -25deg; margin: 0; border: 1px solid var(--rule); background: var(--paper-panel); min-width: 0; overflow: hidden; }
.window-bar { display: flex; align-items: center; gap: 1rem; padding: 1rem 1.25rem; font: .65rem var(--font-mono); border-bottom: 1px solid var(--rule); color: var(--ink-muted); }
.window-dots { font-size: .45rem; letter-spacing: .2em; color: var(--accent); }
.document-desk { display: flex; gap: 1.5rem; padding: 2rem 2.5rem; min-height: 390px; background-image: radial-gradient(var(--rule) .7px, transparent .7px); background-size: 18px 18px; }
.document-rail { width: 34px; flex-shrink: 0; font: .6rem var(--font-mono); color: var(--ink-muted); }.document-rail div { height: 48px; background: var(--paper); border: 1px solid var(--rule); margin: .4rem 0 1.5rem; }
.document-sheet { width: 100%; max-width: 340px; margin: auto; padding: 1.8rem; background: var(--paper); box-shadow: 0 12px 30px #172b2112; transform: rotate(-2deg); transition: transform .5s; position: relative; }
.project-preview:hover .document-sheet { transform: rotate(0); }.doc-label,.doc-page { font: .55rem var(--font-mono); color: var(--ink-muted); letter-spacing: .08em; }.document-sheet h3 { font: 400 clamp(1.5rem,3vw,2rem)/1.1 var(--font-display); letter-spacing: -.04em; margin: 1rem 0; }.doc-rule { width: 28px; height: 2px; background: var(--accent); margin-bottom: 1rem; }.doc-text { font-size: .7rem; line-height: 1.9; margin-top: .8rem; }.marked { transition: background .25s; }.private-text { transition: background .25s,color .25s; }.doc-lines { margin-block: 1rem 1.8rem; }.doc-lines i { display: block; width: 100%; height: 3px; background: var(--rule); margin: .5rem 0; }.doc-lines i:last-child { width: 60%; }.doc-page { display: flex; justify-content: space-between; }.margin-note { position: absolute; right: -.5rem; top: 45%; background: var(--accent-tint); color: var(--accent-deep); font: .6rem var(--font-mono); padding: .5rem; opacity: 0; transform: translateX(5px); transition: .25s; }
[data-tool="highlight"] .marked { background: #dec86b80; }[data-tool="highlight"] .margin-note { opacity: 1; transform: none; }[data-tool="redact"] .private-text { background: var(--ink); color: var(--ink); user-select: none; }
.tool-buttons { display: flex; gap: .25rem; }button { font: .7rem var(--font-mono); border: 1px solid var(--rule); background: var(--paper); min-height: 44px; padding: .5rem .8rem; cursor: pointer; }button:hover { border-color: var(--accent); }

.scene-desk { position: relative; height: 390px; overflow: hidden; background: radial-gradient(ellipse at 50% 60%,var(--accent-tint),transparent 75%); }.scene-label { display: flex; justify-content: space-between; padding: 1.5rem; font: .6rem var(--font-mono); color: var(--ink-muted); }.scene-stage { perspective: 700px; position: absolute; inset: 0; display: grid; place-items: center; }.scene-world { width: 240px; height: 240px; position: relative; transform-style: preserve-3d; transform: translateX(var(--camera-x, 0px)) rotateX(var(--camera-tilt, 58deg)) rotateZ(var(--orbit)) scale(var(--camera-scale, 1)); }.floor { position: absolute; inset: -70px; background-image: linear-gradient(var(--rule) 1px,transparent 1px),linear-gradient(90deg,var(--rule) 1px,transparent 1px); background-size: 30px 30px; border: 1px solid var(--rule); }.cube { --size: 64px; position: absolute; width: var(--size); height: var(--size); transform-style: preserve-3d; }.cube-0 { left: 20px; top: 85px; transform: translateZ(32px); }.cube-1 { left: 120px; top: 30px; transform: translateZ(48px); --size: 96px; }.cube-2 { left: 145px; top: 165px; transform: translateZ(22px); --size: 44px; }.face { position: absolute; inset: 0; border: 1px solid var(--accent-deep); background: var(--accent); opacity: .9; }.front { transform: rotateX(90deg) translateZ(calc(var(--size)/2)); }.back { transform: rotateX(-90deg) translateZ(calc(var(--size)/2)); filter: brightness(.75); }.right { transform: rotateY(90deg) translateZ(calc(var(--size)/2)); filter: brightness(.8); }.left { transform: rotateY(-90deg) translateZ(calc(var(--size)/2)); }.top { transform: translateZ(calc(var(--size)/2)); background: var(--accent-tint); }.bottom { transform: translateZ(calc(var(--size)/-2)); }.scene-origin { position: absolute; bottom: 1.5rem; left: 1.5rem; font: .8rem var(--font-mono); color: var(--accent); }.scene-origin span { margin-left: .5rem; font-size: .6rem; }
@media(max-width:600px) { .document-desk { padding: 1.5rem; gap: .75rem; min-height: 350px; }.document-sheet { padding: 1.3rem; }.document-rail { width: 24px; }.tool-buttons { width: 100%; }.tool-buttons button { flex: 1; }.scene-desk { height: 350px; }.window-bar { gap: .7rem; padding: .9rem; } }
</style>

<style>
.word-tools { border-top: 1px solid var(--rule); padding: 1rem 1.2rem; }.word-tools .tool-buttons { gap: .75rem; }.word-tools button { border: 0; padding: .5rem .4rem; background: transparent; font: 400 clamp(1rem,2vw,1.4rem) var(--font-display); flex: 1; }.word-tools button span { position: relative; display: inline-block; padding: .1rem .12rem; }.word-tools button span::after { content: ''; position: absolute; inset: 0; background: var(--ink); transform: scaleX(0); transform-origin: left; transition: transform .35s cubic-bezier(.2,.7,.3,1); }.word-tools button[data-word-tool="highlight"] span::after { background: #d5bd4a66; inset: 40% -.1rem 0; }.word-tools button[data-word-tool="underline"] span::after { inset: auto 0 0; height: 2px; background: var(--accent); }.word-tools button:hover span::after,.word-tools button:focus span::after { transform: scaleX(1); }
[data-tool="underline"] .marked { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 3px; }
@media(prefers-reduced-motion:reduce) { .scene-world { transform: rotateX(58deg) rotateZ(-25deg) !important; } }
</style>
