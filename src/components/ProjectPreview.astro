---
interface Props { kind: 'openquire' | 'ruster' }
const { kind } = Astro.props;
---
<figure class:list={['project-preview', kind]} data-preview={kind}>
  <div class="window-bar"><span class="window-dots" aria-hidden="true">● ● ●</span><span>{kind === 'openquire' ? 'OpenQuire / document tools' : 'Ruster / scene tools'}</span><span class="local-label">Interactive illustration</span></div>
  {kind === 'openquire' ? <>
    <div class="document-desk">
      <div class="document-rail" aria-hidden="true"><span>01</span><div></div><span>02</span><div></div></div>
      <div class="document-sheet"><p class="doc-label">FIELD NOTES / 001</p><h3>A document,<br />on your device.</h3><div class="doc-rule"></div><p class="doc-text">A few notes about <span class="marked">working with documents</span>, keeping things organized, and making room for the next draft.</p><p class="doc-text">Send a copy to <span class="private-text">alex@example.com</span> when it’s ready.</p><div class="doc-lines" aria-hidden="true"><i></i><i></i><i></i></div><span class="margin-note" aria-hidden="true">Review this passage ↙</span><p class="doc-page">OPENQUIRE <span>1 / 2</span></p></div>
    </div>
    <div class="preview-controls" hidden><span class="control-label">Try a tool</span><div class="tool-buttons" role="group" aria-label="Illustrated document tools"><button type="button" data-tool="read" aria-pressed="true">Read</button><button type="button" data-tool="highlight" aria-pressed="false">Highlight</button><button type="button" data-tool="redact" aria-pressed="false">Redact</button></div></div>
    <figcaption aria-live="polite">A sample document illustrating OpenQuire’s document tools.</figcaption>
  </> : <>
    <div class="scene-desk"><div class="scene-label" aria-hidden="true">PERSPECTIVE <span>X / Y / Z</span></div><div class="scene-stage" aria-hidden="true"><div class="scene-world"><div class="floor"></div>{[0,1,2].map(i => <div class={`cube cube-${i}`}><i class="face front"></i><i class="face back"></i><i class="face right"></i><i class="face left"></i><i class="face top"></i><i class="face bottom"></i></div>)}</div></div><div class="scene-origin" aria-hidden="true">+ <span>Scene origin</span></div></div>
    <div class="preview-controls" hidden><label class="orbit-label">Orbit <input type="range" min="-70" max="70" value="-25" aria-label="Rotate illustrated scene" /></label><button type="button" class="wire-toggle" aria-pressed="false">Wireframe</button></div>
    <figcaption>A small scene to explore. An illustration of the engine’s scene workflow.</figcaption>
  </>}
</figure>
<script>
  for (const preview of document.querySelectorAll<HTMLElement>('[data-preview]')) {
    preview.querySelector<HTMLElement>('.preview-controls')!.hidden = false;
    const note = preview.closest('.feature')?.querySelector<HTMLElement>('.interaction-note');
    if (note) note.hidden = false;
    if (preview.dataset.preview === 'openquire') preview.querySelector('figcaption')!.textContent = 'A sample document. Choose a tool to see how it changes.';
    const descriptions: Record<string, string> = { read: 'Reading view. The sample document stays on your device.', highlight: 'Highlight selected text and add a note for review.', redact: 'The sample email is covered here. In OpenQuire, applied redaction removes the covered content from the PDF.' };
    for (const button of preview.querySelectorAll<HTMLButtonElement>('[data-tool]')) button.addEventListener('click', () => {
      preview.dataset.tool = button.dataset.tool;
      for (const other of preview.querySelectorAll('[data-tool]')) other.setAttribute('aria-pressed', String(other === button));
      preview.querySelector('figcaption')!.textContent = descriptions[button.dataset.tool!];
    });
    preview.querySelector<HTMLInputElement>('input')?.addEventListener('input', event => {
      preview.style.setProperty('--orbit', `${(event.target as HTMLInputElement).value}deg`);
    });
    preview.querySelector<HTMLButtonElement>('.wire-toggle')?.addEventListener('click', event => {
      const button = event.currentTarget as HTMLButtonElement;
      const on = button.getAttribute('aria-pressed') !== 'true';
      button.setAttribute('aria-pressed', String(on)); preview.classList.toggle('wireframe', on);
    });
  }
</script>
<style>
.project-preview { --orbit: -25deg; margin: 0; border: 1px solid var(--rule); background: var(--paper-panel); min-width: 0; overflow: hidden; }
.window-bar { display: flex; align-items: center; gap: 1rem; padding: 1rem 1.25rem; font: .65rem var(--font-mono); border-bottom: 1px solid var(--rule); color: var(--ink-muted); }
.window-dots { font-size: .45rem; letter-spacing: .2em; color: var(--accent); }.local-label { margin-left: auto; font-size: .6rem; }
.document-desk { display: flex; gap: 1.5rem; padding: 2rem 2.5rem; min-height: 390px; background-image: radial-gradient(var(--rule) .7px, transparent .7px); background-size: 18px 18px; }
.document-rail { width: 34px; flex-shrink: 0; font: .6rem var(--font-mono); color: var(--ink-muted); }.document-rail div { height: 48px; background: var(--paper); border: 1px solid var(--rule); margin: .4rem 0 1.5rem; }
.document-sheet { width: 100%; max-width: 340px; margin: auto; padding: 1.8rem; background: var(--paper); box-shadow: 0 12px 30px #172b2112; transform: rotate(-2deg); transition: transform .5s; position: relative; }
.project-preview:hover .document-sheet { transform: rotate(0); }.doc-label,.doc-page { font: .55rem var(--font-mono); color: var(--ink-muted); letter-spacing: .08em; }.document-sheet h3 { font: 400 clamp(1.5rem,3vw,2rem)/1.1 var(--font-display); letter-spacing: -.04em; margin: 1rem 0; }.doc-rule { width: 28px; height: 2px; background: var(--accent); margin-bottom: 1rem; }.doc-text { font-size: .7rem; line-height: 1.9; margin-top: .8rem; }.marked { transition: background .25s; }.private-text { transition: background .25s,color .25s; }.doc-lines { margin-block: 1rem 1.8rem; }.doc-lines i { display: block; width: 100%; height: 3px; background: var(--rule); margin: .5rem 0; }.doc-lines i:last-child { width: 60%; }.doc-page { display: flex; justify-content: space-between; }.margin-note { position: absolute; right: -.5rem; top: 45%; background: var(--accent-tint); color: var(--accent-deep); font: .6rem var(--font-mono); padding: .5rem; opacity: 0; transform: translateX(5px); transition: .25s; }
[data-tool="highlight"] .marked { background: #dec86b80; }[data-tool="highlight"] .margin-note { opacity: 1; transform: none; }[data-tool="redact"] .private-text { background: var(--ink); color: var(--ink); user-select: none; }
.preview-controls { display: flex; align-items: center; justify-content: space-between; gap: .75rem; padding: .8rem 1.2rem; border-top: 1px solid var(--rule); }.control-label { font: .65rem var(--font-mono); color: var(--ink-muted); }.tool-buttons { display: flex; gap: .25rem; }button { font: .7rem var(--font-mono); border: 1px solid var(--rule); background: var(--paper); min-height: 44px; padding: .5rem .8rem; cursor: pointer; }button:hover { border-color: var(--accent); }button[aria-pressed="true"] { background: var(--accent); color: var(--paper); border-color: var(--accent); }
figcaption { min-height: 4.5rem; padding: .85rem 1.2rem; border-top: 1px solid var(--rule); color: var(--ink-muted); font-size: .7rem; line-height: 1.7; }
.scene-desk { position: relative; height: 390px; overflow: hidden; background: radial-gradient(ellipse at 50% 60%,var(--accent-tint),transparent 75%); }.scene-label { display: flex; justify-content: space-between; padding: 1.5rem; font: .6rem var(--font-mono); color: var(--ink-muted); }.scene-stage { perspective: 700px; position: absolute; inset: 0; display: grid; place-items: center; }.scene-world { width: 240px; height: 240px; position: relative; transform-style: preserve-3d; transform: rotateX(58deg) rotateZ(var(--orbit)); transition: transform .15s ease-out; }.floor { position: absolute; inset: -70px; background-image: linear-gradient(var(--rule) 1px,transparent 1px),linear-gradient(90deg,var(--rule) 1px,transparent 1px); background-size: 30px 30px; border: 1px solid var(--rule); }.cube { --size: 64px; position: absolute; width: var(--size); height: var(--size); transform-style: preserve-3d; }.cube-0 { left: 20px; top: 85px; transform: translateZ(32px); }.cube-1 { left: 120px; top: 30px; transform: translateZ(48px); --size: 96px; }.cube-2 { left: 145px; top: 165px; transform: translateZ(22px); --size: 44px; }.face { position: absolute; inset: 0; border: 1px solid var(--accent-deep); background: var(--accent); opacity: .9; }.front { transform: rotateX(90deg) translateZ(calc(var(--size)/2)); }.back { transform: rotateX(-90deg) translateZ(calc(var(--size)/2)); filter: brightness(.75); }.right { transform: rotateY(90deg) translateZ(calc(var(--size)/2)); filter: brightness(.8); }.left { transform: rotateY(-90deg) translateZ(calc(var(--size)/2)); }.top { transform: translateZ(calc(var(--size)/2)); background: var(--accent-tint); }.bottom { transform: translateZ(calc(var(--size)/-2)); }.wireframe .face { background: transparent; filter: none; border: 1px solid var(--accent); }.scene-origin { position: absolute; bottom: 1.5rem; left: 1.5rem; font: .8rem var(--font-mono); color: var(--accent); }.scene-origin span { margin-left: .5rem; font-size: .6rem; }.orbit-label { display: flex; align-items: center; gap: 1rem; font: .7rem var(--font-mono); min-width: 0; }input { width: min(160px,28vw); accent-color: var(--accent); min-height: 44px; }
@media(max-width:600px) { .local-label { display: none; }.document-desk { padding: 1.5rem; gap: .75rem; min-height: 350px; }.document-sheet { padding: 1.3rem; }.document-rail { width: 24px; }.preview-controls { padding: .6rem .8rem; }.control-label { display: none; }.tool-buttons { width: 100%; }.tool-buttons button { flex: 1; }.scene-desk { height: 350px; }.window-bar { gap: .7rem; padding: .9rem; } }
</style>
