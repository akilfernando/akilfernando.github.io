<figure class="research-diagram" data-research-diagram>
  <svg viewBox="0 0 400 320" role="img" aria-labelledby="diagram-title diagram-description">
    <title id="diagram-title">A bug can cross the code and asset boundary</title>
    <desc id="diagram-description">Illustrative Unity dependencies: a scene references a prefab, which references a script and a material. A fix may involve more than one of these files. This is a conceptual example, not a study result.</desc>
    <defs><pattern id="diagram-grid" width="22" height="22" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".7" fill="currentColor" opacity=".15" /></pattern><marker id="dependency-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10" fill="none" stroke="currentColor" /></marker></defs>
    <rect width="400" height="320" fill="url(#diagram-grid)" />
    <g fill="none" stroke="currentColor" opacity=".65" marker-end="url(#dependency-arrow)"><path d="M200 72 V120" /><path d="M200 162 V190 H98 V228" /><path d="M200 190 H302 V228" /></g>
    <g fill="var(--paper)" stroke="currentColor"><rect data-node="scene" x="133" y="30" width="134" height="42" /><rect data-node="prefab" x="133" y="120" width="134" height="42" /><rect data-node="script" x="31" y="228" width="134" height="42" /><rect data-node="material" x="235" y="228" width="134" height="42" /></g>
    <g fill="currentColor" font-family="var(--font-mono)" font-size="13" text-anchor="middle"><text x="200" y="56">Scene</text><text x="200" y="146">Prefab</text><text x="98" y="254">C# script</text><text x="302" y="254">Material</text><text x="98" y="294" font-size="10">CODE</text><text x="302" y="294" font-size="10">ASSET</text></g>
    <text x="216" y="101" fill="currentColor" font-family="var(--font-mono)" font-size="10">references</text>
  </svg>
  <div class="diagram-controls" role="group" aria-label="Explore Unity file dependencies" hidden><button type="button" data-node-choice="scene" aria-pressed="true">Scene</button><button type="button" data-node-choice="prefab" aria-pressed="false">Prefab</button><button type="button" data-node-choice="script" aria-pressed="false">Script</button><button type="button" data-node-choice="material" aria-pressed="false">Material</button></div>
  <figcaption><p class="diagram-explanation" aria-live="polite">A scene references a prefab, which connects a script and a material. A fix can involve several of these files.</p><span>Illustrative Unity dependencies, not a research result</span></figcaption>
</figure>
<script>
  const explanations: Record<string, string> = {
    scene: 'The scene places objects in the game. A scene change can affect how a prefab behaves.',
    prefab: 'The prefab connects reusable objects with scripts and materials. A broken reference can involve several files.',
    script: 'The C# script defines behavior. A code fix may also need changes to the assets that use it.',
    material: 'The material controls appearance. A rendering bug can involve this asset as well as code.'
  };
  for (const figure of document.querySelectorAll<HTMLElement>('[data-research-diagram]')) {
    figure.querySelector<HTMLElement>('.diagram-controls')!.hidden = false;
    for (const button of figure.querySelectorAll<HTMLButtonElement>('button')) button.addEventListener('click', () => {
      for (const other of figure.querySelectorAll('button')) other.setAttribute('aria-pressed', String(other === button));
      for (const node of figure.querySelectorAll('[data-node]')) node.classList.toggle('selected-node', node.getAttribute('data-node') === button.dataset.nodeChoice);
      figure.querySelector('.diagram-explanation')!.textContent = explanations[button.dataset.nodeChoice!];
    });
    figure.querySelector('[data-node="scene"]')?.classList.add('selected-node');
  }
</script>
<style>
.diagram-controls { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: 1rem; }button { flex: 1; font: .7rem var(--font-mono); padding: .6rem; min-height: 44px; border: 1px solid var(--rule); color: var(--accent); background: var(--paper); cursor: pointer; }button[aria-pressed="true"] { background: var(--accent); color: var(--paper); border-color: var(--accent); }.research-diagram [data-node] { transition: fill .25s,stroke-width .25s; }.research-diagram .selected-node { fill: var(--accent-tint); stroke-width: 2; }.diagram-explanation { min-height: 5.5em; }

.research-diagram { color: var(--accent); width: 100%; max-width: 400px; }
figcaption { border-top: 1px solid var(--rule); padding-top: .8rem; font-size: .8125rem; color: var(--ink); }
figcaption span { display: block; margin-top: .3rem; font-family: var(--font-mono); color: var(--ink-muted); font-size: .675rem; }
</style>
