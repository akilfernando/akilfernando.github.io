---
const photos = [
  { name: 'us-together', alt: 'The two of us smiling together under a woven canopy.', width: 1280, height: 960 },
  { name: 'laughing-together', alt: 'Savi laughing beside me while I look over at her.', width: 986, height: 1280 },
  { name: 'together-in-black-and-white', alt: 'A black-and-white photo of us, with Savi wearing sunglasses.', width: 942, height: 1280 },
  { name: 'hands-together', alt: 'Our hands together, with little drawings and words on Savi’s hand.', width: 960, height: 1280 },
  { name: 'bus-home', alt: 'Holding hands on the bus, resting on our laps.', width: 960, height: 1280 },
  { name: 'movie-night', alt: 'Watching a movie in my room, with Savi’s legs on my lap.', width: 960, height: 1280 },
  { name: 'savi', alt: 'Savi tucked up with a soft toy, peeking over it at the camera.', width: 720, height: 1280 },
];
---
<section class="album" aria-labelledby="album-heading">
  <div class="section-kicker"><span></span><h2 id="album-heading">A little bit of us</h2><span></span></div>
  <div class="photo-grid">{photos.map((photo,i)=><a class:list={['photo-keepsake',{wide:photo.width>photo.height}]} href={`/sav/memories/${photo.name}.webp`} data-photo-index={i} aria-label={`Enlarge photo: ${photo.alt}`}><img src={`/sav/memories/${photo.name}-small.webp`} srcset={`/sav/memories/${photo.name}-small.webp 640w, /sav/memories/${photo.name}.webp ${photo.width}w`} sizes={photo.width>photo.height ? '(max-width: 760px) 90vw, 700px' : '(max-width: 600px) 42vw, 340px'} width={photo.width} height={photo.height} alt={photo.alt} loading="lazy" decoding="async" /></a>)}</div>
  <dialog class="photo-viewer" aria-label="Our photo album">
    <button class="close-photo" type="button" aria-label="Close photo">×</button>
    <img class="full-photo" alt="" />
    <div class="photo-navigation"><button type="button" class="previous-photo" aria-label="Previous photo">←</button><span class="photo-count" aria-live="polite"></span><button type="button" class="next-photo" aria-label="Next photo">→</button></div>
  </dialog>
  <figure class="video-keepsake">
    <div class="paper-tape" aria-hidden="true"></div>
    <video controls playsinline preload="none" poster="/sav/memories/our-video-poster.jpg" width="640" height="480" aria-label="A video of us together">
      <source src="/sav/memories/our-video.mp4" type="video/mp4" />
      <a href="/sav/memories/our-video.mp4">Watch our video</a>
    </video>
  </figure>
</section>
<style>
.album { padding-top:4rem;max-width:760px;margin-inline:auto; }.section-kicker { display:flex;align-items:center;justify-content:center;gap:1.5rem;margin-bottom:2.5rem; }.section-kicker>span { height:1px;max-width:80px;flex:1;background:var(--rule); }h2 { font:400 clamp(1.5rem,3vw,2rem) var(--font-display);color:var(--accent);text-align:center; }.video-keepsake { position:relative;padding:clamp(.6rem,2vw,1rem);background:#fffaf3;border:1px solid var(--rule);box-shadow:0 10px 30px #67482e0b;transform:rotate(-1deg);margin:0 1rem; }.paper-tape { position:absolute;top:-.7rem;left:calc(50% - 38px);width:76px;height:24px;transform:rotate(4deg);background:#d8c6aa99;border-inline:1px dashed #c4ae8d66;z-index:1;pointer-events:none; }video { display:block;width:100%;height:auto;aspect-ratio:4/3;background:#332a26;object-fit:contain; }@media(prefers-reduced-motion:reduce) { .video-keepsake { transform:none; } }
</style>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-photo-index]'));
  const viewer = document.querySelector<HTMLDialogElement>('.photo-viewer');
  if (viewer) {
    const photo = viewer.querySelector<HTMLImageElement>('.full-photo')!;
    let current = 0;
    let opener = 0;
    let previousOverflow = '';
    function show(index: number) {
      current = (index + links.length) % links.length;
      photo.src = links[current].href;
      photo.alt = links[current].querySelector('img')!.alt;
      viewer!.querySelector('.photo-count')!.textContent = `${current + 1} / ${links.length}`;
    }
    links.forEach((link,index) => link.addEventListener('click', event => {
      event.preventDefault(); opener = index; show(index); previousOverflow = document.body.style.overflow;
      viewer.showModal(); document.body.style.overflow = 'hidden';
      document.querySelector('video')?.pause();
    }));
    viewer.querySelector('.close-photo')!.addEventListener('click', () => viewer.close());
    viewer.querySelector('.previous-photo')!.addEventListener('click', () => show(current - 1));
    viewer.querySelector('.next-photo')!.addEventListener('click', () => show(current + 1));
    viewer.addEventListener('keydown', event => {
      if (event.key === 'ArrowLeft') { event.preventDefault(); show(current - 1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); show(current + 1); }
    });
    viewer.addEventListener('click', event => { if (event.target === viewer) { const r=viewer.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)viewer.close(); } });
    viewer.addEventListener('close', () => { document.body.style.overflow = previousOverflow; links[opener]?.focus({preventScroll:true}); });
  }
</script>
<style>
.photo-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2rem 1.5rem;margin:0 1rem 3rem;align-items:start; }.photo-keepsake { display:block;background:#fffaf3;padding:clamp(.4rem,1.5vw,.8rem);border:1px solid var(--rule);box-shadow:0 8px 25px #67482e0d;transform:rotate(-1.5deg);transition:transform .3s;cursor:zoom-in; }.photo-keepsake:nth-child(3n) { transform:rotate(1.5deg); }.photo-keepsake:hover,.photo-keepsake:focus-visible { transform:rotate(0); }.photo-keepsake.wide { grid-column:1 / -1; }.photo-keepsake img { width:100%;height:auto;display:block; }.photo-viewer { margin:auto;padding:3.2rem .8rem .6rem;max-width:calc(100vw - 1.5rem);max-height:94dvh;border:1px solid var(--rule);background:#fffaf3;color:var(--ink);overflow:auto; }.photo-viewer::backdrop { background:#211519db; }.full-photo { display:block;width:auto;max-width:calc(100vw - 3.5rem);max-height:75dvh;object-fit:contain;margin:auto; }.close-photo { position:absolute;top:.2rem;right:.4rem; }.photo-viewer button { background:transparent;color:var(--accent);border:0;min-width:44px;min-height:44px;font-size:1.6rem;cursor:pointer; }.photo-navigation { display:flex;align-items:center;justify-content:space-between;margin-top:.4rem;gap:2rem; }.photo-count { font:.7rem var(--font-mono);color:var(--ink-muted); }@media(max-width:600px){.photo-grid{gap:1rem .8rem;margin-inline:.4rem;}}@media(prefers-reduced-motion:reduce){.photo-keepsake,.photo-keepsake:hover,.photo-keepsake:focus-visible{transform:none;}}
</style>
