---
const themes = [
  { value: 'light', label: 'Light', path: 'M12 3V1 M12 23v-2 M3 12H1 M23 12h-2 M5.6 5.6 4.2 4.2 M19.8 19.8l-1.4-1.4 M5.6 18.4l-1.4 1.4 M19.8 4.2l-1.4 1.4 M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0' },
  { value: 'dark', label: 'Dark', path: 'M20.5 14A8.5 8.5 0 0 1 10 3.5 8.5 8.5 0 1 0 20.5 14Z' },
  { value: 'system', label: 'System default', path: 'M3 4h18v12H3Z M8 21h8 M12 16v5' },
];
---
<div class="theme-control" hidden>
  <button class="theme-trigger" type="button" aria-label="Color theme: System default" title="Color theme: System default" aria-expanded="false" aria-controls="theme-options">
    {themes.map(t => <svg data-theme-icon={t.value} hidden={t.value !== 'system'} width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={t.path} /></svg>)}
  </button>
  <div class="theme-options" id="theme-options" role="group" aria-label="Color theme" hidden>
    {themes.map(t => <button type="button" data-theme-choice={t.value} aria-label={t.label} title={t.label} aria-pressed={t.value === 'system' ? 'true' : 'false'}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={t.path} /></svg></button>)}
  </div>
</div>
<script>
  const control = document.querySelector<HTMLElement>('.theme-control');
  const trigger = control?.querySelector<HTMLButtonElement>('.theme-trigger');
  const panel = control?.querySelector<HTMLElement>('.theme-options');
  if (control && trigger && panel) {
    const choices = Array.from(panel.querySelectorAll<HTMLButtonElement>('[data-theme-choice]'));
    const icons = Array.from(trigger.querySelectorAll<SVGElement>('[data-theme-icon]'));
    function sync() {
      const theme = document.documentElement.dataset.theme || 'system';
      const label = theme === 'system' ? 'System default' : theme === 'dark' ? 'Dark' : 'Light';
      trigger!.setAttribute('aria-label', `Color theme: ${label}`);
      trigger!.title = `Color theme: ${label}`;
      for (const icon of icons) icon.toggleAttribute('hidden', icon.dataset.themeIcon !== theme);
      for (const button of choices) button.setAttribute('aria-pressed', String(button.dataset.themeChoice === theme));
    }
    function close(returnFocus = false) {
      panel!.hidden = true;
      trigger!.setAttribute('aria-expanded', 'false');
      if (returnFocus) trigger!.focus();
    }
    trigger.addEventListener('click', () => {
      const opening = panel.hidden;
      panel.hidden = !opening;
      trigger.setAttribute('aria-expanded', String(opening));
      if (opening) (choices.find(b => b.getAttribute('aria-pressed') === 'true') || choices[0]).focus();
    });
    for (const button of choices) button.addEventListener('click', () => {
      const choice = button.dataset.themeChoice!;
      if (choice === 'system') delete document.documentElement.dataset.theme;
      else document.documentElement.dataset.theme = choice;
      try { if (choice === 'system') localStorage.removeItem('theme'); else localStorage.setItem('theme', choice); } catch {}
      sync(); close(true);
    });
    control.addEventListener('keydown', event => { if (event.key === 'Escape' && !panel.hidden) { event.preventDefault(); close(true); } });
    document.addEventListener('click', event => { if (!control.contains(event.target as Node)) close(); });
    control.addEventListener('focusout', event => { if (!control.contains(event.relatedTarget as Node | null)) close(); });
    sync(); control.hidden = false;
  }
</script>
<style>
.theme-control { position: relative; color: var(--ink-muted); }
button { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; color: inherit; background: transparent; border: 1px solid transparent; cursor: pointer; }
button:hover, button:focus-visible { color: var(--accent); background: var(--accent-tint); }
.theme-trigger[aria-expanded="true"] { border-color: var(--rule); color: var(--accent); }
.theme-options { position: absolute; top: calc(100% + 8px); right: 0; display: flex; gap: 4px; padding: 6px; background: var(--paper); border: 1px solid var(--rule); box-shadow: 0 8px 24px #0002; z-index: 20; }
.theme-options button[aria-pressed="true"] { color: var(--accent); background: var(--accent-tint); border-color: var(--accent); }
:global(html[data-retro="on"]) .theme-control { display: none; }
</style>
