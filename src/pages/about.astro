---
import BaseLayout from '../layouts/BaseLayout.astro';
import { socials } from '../config';

const interests = [
  'IT Operations & ISO 27001 Security',
  'Software & Systems Development',
  'Game Engine & Graphics Engineering',
  'AI & Machine Learning Research',
  'Network Security & Fault Localization',
  'Empirical Software Engineering',
];
---
<BaseLayout title="About" description="Who I am, what I build, and what keeps me curious.">
  <p class="eyebrow">About</p>
  <div class="wayrule"></div>
  <h1 class="display h1">Hello.</h1>

  <p class="lede">I am Akil. I lead IT operations and cybersecurity, build production software platforms, and explore research across software engineering, AI, and systems security.</p>

  <div class="prose">
    <p>By day, I lead IT operations and cybersecurity at Teams Squared, a global remote staffing firm placing skilled professionals worldwide. Alongside managing Entra ID identity architecture, endpoint defense, and infrastructure across distributed teams, I serve as the appointed ISMS Officer driving ISO 27001 compliance. I value this operational work - the discipline of building dependable, audited environments and establishing resilient access governance.</p>

    <p>Software development has been a core pursuit since high school. Today, I combine hands-on engineering with modern AI tooling to design and ship production software. At Teams Squared, I architected internal platforms from scratch, including our contractor training LMS, hardware fleet tracking system, and company client portal. Building production tools end to end gives me a clear sense of how complex systems perform under real operational constraints.</p>

    <p>That practical engineering grounding feeds my broader interest in research. I am fascinated by open questions across artificial intelligence, network security, game engine build pipelines, and empirical software engineering. Research to me is about uncovering clarity in complex technical domains. I hold a Bachelor of Science in Computer Science from Dalhousie University (GPA 3.92, Sexton Scholar), and I am interested in exploring research opportunities and academic programs, including potential PhD work.</p>
  </div>

  <h2 class="sec-label" id="looking">What I'm looking for</h2>
  <p class="seeking">I am open to compelling opportunities across multiple paths: advancing enterprise <strong>IT Operations, Cybersecurity, &amp; ISO 27001 ISMS governance</strong>, taking on <strong>software engineering or game/systems development</strong> roles, or collaborating with <strong>research labs and graduate programs</strong> across AI, security, and software engineering. I hold a Canadian Post-Graduation Work Permit (PGWP) valid through June 2029 and am open to relocation within Canada. If you are building reliable systems or exploring new research frontiers, let's connect.</p>

  <h2 class="sec-label">What keeps me curious</h2>
  <ul class="interests">
    {interests.map((i) => <li>{i}</li>)}
  </ul>

  <h2 class="sec-label">Elsewhere</h2>
  <ul class="contact">
    {socials.map((s) => (
      <li>
        <span class="c-label">{s.label}</span>
        <a href={s.href} target="_blank" rel="noopener noreferrer">{s.handle ?? s.label}</a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .h1 { font-size: clamp(2.4rem, 6vw, 3.4rem); margin-top: var(--space-1); }
  .lede {
    font-size: 1.0625rem; color: var(--ink-muted); line-height: 1.6;
    max-width: 58ch; margin-top: var(--space-2);
  }
  .prose { max-width: var(--measure); margin-top: var(--space-3); }
  .prose p { margin-bottom: var(--space-2); color: var(--ink); }
  .seeking {
    max-width: var(--measure); margin-top: var(--space-2); color: var(--ink); line-height: 1.6;
    border-left: 2px solid var(--cobalt); padding-left: var(--space-2);
  }
  .sec-label {
    font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 500;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-muted);
    margin: var(--space-8) 0 var(--space-2);
    padding-bottom: var(--space-1);
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 5rem;
  }
  .interests { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .interests li {
    font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-muted);
    background: var(--paper-panel); padding: 5px 11px;
  }
  .contact { list-style: none; padding: 0; margin-top: var(--space-2); max-width: 32rem; }
  .contact li {
    display: grid; grid-template-columns: 7rem 1fr; gap: var(--space-2);
    padding: var(--space-1) 0; border-bottom: 1px solid var(--rule);
    font-family: var(--font-mono); font-size: 0.8125rem; align-items: baseline;
  }
  .contact li:last-child { border-bottom: none; }
  .c-label { color: var(--ink-muted); text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.6875rem; }
  .contact a { color: var(--cobalt); text-decoration: none; word-break: break-word; }
  .contact a:hover { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 620px) {
    .contact li { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
