---
import { externalLinkAttributes } from '../utils/external-links.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import { socials } from '../config';
---
<BaseLayout title="About" description="Akil Fernando: incoming MSc student in Computer Science at the University of Calgary, with a background in software, games, IT, and cybersecurity.">
  <header class="page-intro"><p class="eyebrow">About</p><h1 class="display">About me</h1><p class="intro-copy">I'm Akil, a software engineer based in Colombo. I've worked in game development, IT operations, and cybersecurity, and I'm preparing for graduate research.</p></header>
  <section class="section-grid" aria-labelledby="background"><p class="overline">01 / Background</p><div><h2 class="display section-title" id="background">How I got here</h2><div class="body-copy"><p>Software development has been a part of my life since high school. That interest took me to Dalhousie University, where I completed a <strong>Bachelor of Computer Science</strong> in 2025, with a GPA of 3.92 and recognition as a Sexton Scholar.</p><p>During my gameplay programming co-op at Ubisoft Halifax, I worked in Unity and C# on cameras, targeting, character AI, and debugging tools. I also built personal graphics projects in OpenGL and Vulkan to learn more about rendering and GPU programming.</p><p>At Teams Squared, I lead IT operations and cybersecurity. That includes identity governance, endpoint security, and the organization's ISO 27001:2022 ISMS. I also build internal software: a training platform, a fleet management system, and a client portal. I maintain these tools alongside the IT systems they support.</p><p>Outside that role, I’m building <a href="/projects/openquire">OpenQuire</a>, an open-source PDF app, and <a href="/projects/ruster">Ruster</a>, an early Rust engine project for interactive applications.</p></div><a class="text-link" href="/career">Experience &amp; education</a></div></section>
  <section class="section-grid" aria-labelledby="next"><p class="overline">02 / What's next</p><div><h2 class="display section-title" id="next">Graduate study</h2><div class="body-copy"><p>I'm an incoming MSc student in Computer Science at the University of Calgary. My proposed research, with Dr. Nimmi Weeraddana, examines bugs that require coordinated changes to source code and assets in open-source Unity games.</p><p>I'd like to study whether tools that use these relationships can help developers find bugs. That means testing them against existing approaches and understanding where they help and where they fall short.</p></div><a class="text-link" href="/research">Research direction</a></div></section>
  <section class="section-grid" aria-labelledby="outside"><p class="overline">03 / Outside the work</p><div><h2 class="display section-title" id="outside">Outside work</h2><div class="body-copy"><p>I also write fiction, play games, and keep notes on books and film. I keep some of that writing and those notes here.</p><p>Some of that lives in my <a href="/writing">creative writing</a> and my <a href="/log">reading and playing log</a>. Technical reflections go in the <a href="/blog">notes</a>.</p></div></div></section>
  <section class="section-grid" aria-labelledby="contact"><p class="overline">04 / Contact</p><div><h2 class="display section-title" id="contact">Get in touch</h2><ul class="contact-list">{socials.map(s => <li><span>{s.label}</span><a href={s.href} {...externalLinkAttributes(s.href)}>{s.handle}<span aria-hidden="true"> ↗</span></a></li>)}</ul></div></section>
</BaseLayout>
<style>
  .contact-list a { width: fit-content; background-image: linear-gradient(var(--accent),var(--accent)); background-position: left bottom; background-repeat: no-repeat; background-size: 0 1px; transition: background-size .35s; }.contact-list a:hover,.contact-list a:focus-visible { background-size: 100% 1px; }.contact-list a span { display: inline-block; transition: transform .3s; }.contact-list a:hover span,.contact-list a:focus-visible span { transform: translate(3px,-3px); }

  .contact-list { list-style: none; padding: 0; margin-top: 2rem; max-width: 40rem; }
  .contact-list li { display: grid; grid-template-columns: 6rem 1fr; gap: 1.5rem; border-top: 1px solid var(--rule); padding-block: 1rem; font-size: .875rem; }
  .contact-list li > span { color: var(--ink-muted); font-family: var(--font-mono); font-size: .7rem; padding-top: .15rem; }
  .contact-list a { color: var(--accent); text-decoration: none; overflow-wrap: anywhere; }
  .contact-list a:hover { text-decoration: underline; }
  @media (max-width: 450px) { .contact-list li { grid-template-columns: 1fr; gap: .4rem; } }
</style>
