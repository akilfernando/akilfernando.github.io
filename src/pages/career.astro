---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experience, education, certifications, skills, cvs } from '../data/career';
const timeline = [{ label: 'Experience', number: '01', rows: experience }, { label: 'Education', number: '02', rows: education }];
---
<BaseLayout title="Career" description="Akil Fernando's experience in software, game development, IT operations, and cybersecurity, plus education and professional CVs.">
  <header class="page-intro"><p class="eyebrow">Career / Experience &amp; education</p><h1 class="display">A background<br />in building.</h1><p class="intro-copy">From gameplay systems to software platforms and security operations. The practical experience I bring to my next chapter in research.</p></header>
  {timeline.map(block => <section class="section-grid career-section" aria-labelledby={`career-${block.number}`}><h2 class="overline" id={`career-${block.number}`}>{block.number} / {block.label}</h2><div>{block.rows.map(r => <article class="timeline-item"><p class="date">{r.start ? `${r.start} - ${r.end}` : r.end}</p><h3 class="display">{r.role}</h3>{r.org && <p class="org">{r.org}{r.location && <span> / {r.location}</span>}</p>}{r.summary && <p class="summary">{r.summary}</p>}{r.highlights && r.highlights.length > 0 && <ul class="highlights">{r.highlights.map(h => <li>{h}</li>)}</ul>}</article>)}</div></section>)}
  <section class="section-grid" aria-labelledby="ongoing-project"><h2 class="overline" id="ongoing-project">03 / Ongoing project</h2><article><p class="date">2026 - Present / Independent work</p><h3 class="display project-heading">OpenQuire</h3><p class="summary">I’m building an open-source PDF toolkit for the browser and desktop. Document processing runs on the user’s device, with optional AI features controlled by the user.</p><div class="project-links"><a class="text-link" href="https://github.com/akilfernando/openquire">OpenQuire on GitHub</a><a class="text-link" href="/projects/openquire">Read about the project</a></div></article></section>
  <section class="section-grid" aria-labelledby="credentials"><h2 class="overline" id="credentials">04 / Certification</h2><ul class="certifications">{certifications.map(c => <li>{c}</li>)}</ul></section>
  <section class="section-grid" aria-labelledby="skills"><h2 class="overline" id="skills">05 / Technical practice</h2><div class="skills">{skills.map(g => <div><h3>{g.group}</h3><p>{g.items.join(', ')}</p></div>)}</div></section>
  <section class="section-grid" aria-labelledby="cv"><h2 class="overline" id="cv">06 / Professional CVs</h2><div><h3 class="display cv-title">The industry background,<br />in more detail.</h3><p class="cv-note">Choose a field-specific CV. Each link opens a PDF.</p><ul class="cvs">{cvs.map(c => <li><a href={c.file}><span>{c.field}</span><span class="pdf">View PDF ↗</span></a></li>)}</ul></div></section>
</BaseLayout>
<style>
  .timeline-item + .timeline-item { border-top: 1px solid var(--rule); padding-top: 2.5rem; margin-top: 2.5rem; }
  .date { font-family: var(--font-mono); color: var(--accent); font-size: .7rem; margin-bottom: .75rem; }
  .timeline-item h3 { font-size: clamp(1.75rem, 3vw, 2.4rem); line-height: 1.15; max-width: 24ch; }
  .org { margin-top: .75rem; font-size: .8125rem; color: var(--accent); }
  .org span { color: var(--ink-muted); }
  .summary { color: var(--ink-muted); font-size: .9375rem; max-width: 65ch; margin-top: 1.5rem; }
  .highlights { padding-left: 1.1rem; margin-top: 1.5rem; max-width: 65ch; }
  .highlights li { font-size: .875rem; padding-left: .4rem; margin-top: .75rem; color: var(--ink-muted); }
  .highlights li::marker { color: var(--accent); }
  .certifications { list-style: none; padding: 0; font-size: .9375rem; max-width: 60ch; }
  .skills { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .skills h3 { font-size: .875rem; font-weight: 500; }
  .skills p { font-size: .8125rem; color: var(--ink-muted); margin-top: .5rem; }
  .project-heading { font-size: clamp(2rem, 4vw, 3rem); }
  .project-links { display: flex; flex-wrap: wrap; gap: .5rem 2rem; margin-top: 1.5rem; font-size: .8125rem; }
  .cv-title { font-size: clamp(2rem, 4vw, 3rem); }
  .cv-note { margin-top: 1rem; font-size: .8125rem; color: var(--ink-muted); }
  .cvs { list-style: none; padding: 0; margin-top: 2rem; max-width: 34rem; }
  .cvs li { border-top: 1px solid var(--rule); }
  .cvs a:hover { background: var(--accent-tint); text-decoration: underline; }
  .cvs a { display: flex; justify-content: space-between; padding-block: 1rem; text-decoration: none; font-size: .875rem; color: var(--accent); }
  .pdf { font-family: var(--font-mono); font-size: .7rem; }
  @media (max-width: 500px) { .skills { grid-template-columns: 1fr; } }
</style>
