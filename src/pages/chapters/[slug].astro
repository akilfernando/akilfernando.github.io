---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChapterScene from '../../components/ChapterScene.astro';
import { chapters } from '../../data/chapters';
export function getStaticPaths() { return chapters.map((chapter,index)=>({params:{slug:chapter.slug},props:{chapter,index}})); }
interface Props { chapter: typeof chapters[number]; index: number }
const { chapter, index } = Astro.props;
const previous = chapters[index-1]; const next = chapters[index+1];
---
<BaseLayout title={chapter.title} description={chapter.intro}>
  <a class="chapter-back" href="/chapters">← All chapters</a>
  <header class="chapter-header" data-reveal><p class="eyebrow">{String(index+1).padStart(2,'0')} / {chapter.category}</p><h1 class="display">{chapter.title}</h1><div class="chapter-meta">{chapter.role && <span>{chapter.role}</span>}{chapter.period && <span>{chapter.period}</span>}</div></header>
  <div class="chapter-opening"><p>{chapter.intro}</p><ChapterScene kind={chapter.slug}/></div>
  {chapter.sections.map((section,i)=><section class="section-grid" aria-labelledby={`section-${i}`}><p class="overline">{String(i+1).padStart(2,'0')}</p><div><h2 class="display section-title" id={`section-${i}`}>{section.title}</h2><div class="body-copy">{section.paragraphs.map(paragraph=><p>{paragraph}</p>)}</div></div></section>)}
  {chapter.links.length>0 && <section class="section-grid" aria-labelledby="related"><h2 class="overline" id="related">Related work</h2><ul class="related">{chapter.links.map(link=><li><a class="text-link" href={link.href}>{link.label}</a></li>)}</ul></section>}
  <nav class="chapter-navigation" aria-label="Other chapters">{previous ? <a href={`/chapters/${previous.slug}`}><span>Previous</span><strong class="display">{previous.title}</strong></a>:<a href="/chapters"><span>Browse</span><strong class="display">All chapters</strong></a>}{next ? <a href={`/chapters/${next.slug}`}><span>Next</span><strong class="display">{next.title}</strong></a>:<a href="/chapters"><span>Browse</span><strong class="display">All chapters</strong></a>}</nav>
</BaseLayout>
<style>
.chapter-back { display:inline-flex;min-height:44px;align-items:center;font:.7rem var(--font-mono);color:var(--ink-muted);text-decoration:none; }.chapter-header { padding-block:2rem 3rem; }.chapter-header h1 { font-size:clamp(3rem,7vw,6.5rem);max-width:16ch;margin-block:1.5rem; }.chapter-meta { display:flex;flex-wrap:wrap;gap:.75rem 2rem;font:.75rem var(--font-mono);color:var(--ink-muted); }.chapter-opening { display:grid;grid-template-columns:.8fr 1.2fr;gap:4rem;align-items:center;padding-block:1rem 4rem;border-bottom:1px solid var(--rule); }.chapter-opening>p { font-size:clamp(1.1rem,2vw,1.4rem);line-height:1.8;color:var(--ink-muted); }.related { list-style:none;display:flex;flex-wrap:wrap;gap:.5rem 2rem;padding:0; }.related .text-link { margin-top:0; }.chapter-navigation { display:grid;grid-template-columns:1fr 1fr;gap:2rem;padding-top:4rem; }.chapter-navigation a { text-decoration:none;border-top:1px solid var(--rule);padding:1.5rem 0; }.chapter-navigation span { display:block;font:.65rem var(--font-mono);color:var(--ink-muted);margin-bottom:1rem; }.chapter-navigation strong { font-size:clamp(1.5rem,3vw,2.3rem);font-weight:400; }.chapter-navigation a:last-child { text-align:right; }.chapter-navigation a:hover { border-color:var(--accent); }@media(max-width:700px){.chapter-opening{grid-template-columns:1fr;gap:2rem;padding-bottom:2.5rem;}.chapter-navigation{gap:1rem;}}
</style>
