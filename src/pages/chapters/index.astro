---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChapterScene from '../../components/ChapterScene.astro';
import { chapters } from '../../data/chapters';
---
<BaseLayout title="Chapters" description="My time in education and work, from Universal College Lanka and Dalhousie to Halifax, Teams Squared, and the University of Calgary.">
  <header class="page-intro"><p class="eyebrow">Education &amp; work</p><h1 class="display">Chapters</h1><p class="intro-copy">The places I’ve studied and worked, and where I’m heading next.</p></header>
  <ol class="chapters">{chapters.map((chapter,i)=><li data-reveal><a href={`/chapters/${chapter.slug}`}><ChapterScene kind={chapter.slug}/><div class="card-meta"><span>{String(i+1).padStart(2,'0')} / {chapter.category}</span><span aria-hidden="true">↗</span></div><h2 class="display">{chapter.title}</h2><p>{chapter.role || chapter.category}</p>{chapter.period && <span class="period">{chapter.period}</span>}</a></li>)}</ol>
</BaseLayout>
<style>
.chapters { display:grid;grid-template-columns:1fr 1fr;gap:4rem 2rem;list-style:none;padding:3rem 0; }.chapters a { display:block;text-decoration:none; }.card-meta { display:flex;justify-content:space-between;font:.7rem var(--font-mono);color:var(--accent);padding-block:1.2rem; }.card-meta span:last-child { transition:transform .3s; }.chapters a:hover .card-meta span:last-child,.chapters a:focus-visible .card-meta span:last-child { transform:translate(4px,-4px); }h2 { font-size:clamp(1.8rem,3vw,2.8rem); }li p { font-size:.85rem;color:var(--ink-muted);margin-top:.8rem; }.period { display:block;font:.65rem var(--font-mono);color:var(--ink-muted);margin-top:.75rem; }@media(max-width:650px){.chapters{grid-template-columns:1fr;gap:3rem;}}
</style>
