---
import ChapterScene from '../components/ChapterScene.astro';
import { chapters } from '../data/chapters';
import ProjectPreview from '../components/ProjectPreview.astro';
import ResearchDiagram from '../components/ResearchDiagram.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, socials } from '../config';
const paths = [
  { number: '01', title: 'Research', href: '/research', description: 'My proposed graduate work and the questions I want to investigate.' },
  { number: '02', title: 'Projects', href: '/projects', description: 'Software, games, and tools I have built, with the decisions behind them.' },
  { number: '03', title: 'Background', href: '/career', description: 'Professional experience, education, and CVs.' },
];
const personSchema = { '@context': 'https://schema.org', '@type': 'Person', name: site.name, url: site.url, alumniOf: { '@type': 'CollegeOrUniversity', name: 'Dalhousie University' }, sameAs: socials.filter(s => s.href.startsWith('http')).map(s => s.href) };
---
<BaseLayout description="Akil Fernando: software engineer and incoming Computer Science MSc student at the University of Calgary, with experience in games, IT, and cybersecurity.">
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <nav class="page-index" aria-label="On this page"><a href="#identity">Introduction</a><a href="#life-chapters">Chapters</a><a href="#selected-work">Selected work</a><a href="#research-preview">Research</a><span>Portfolio / 2026</span></nav>
  <section class="hero" aria-labelledby="identity">
    <div class="hero-top"><p class="eyebrow">Engineering &amp; research</p><p class="location">Colombo, Sri Lanka</p></div>
    <div class="hero-grid" data-reveal>
      <div><h1 class="display" id="identity">Akil<br />Fernando<span>.</span></h1><p class="hero-copy">Software engineer and<br />incoming MSc student.</p></div>
      <div class="introduction"><p class="overline">A little about me</p><p>I build software and work with the systems around it. My background spans game development, IT operations, and cybersecurity.</p><p>I’m an incoming MSc student in Computer Science at the University of Calgary, where I plan to study bugs in games.</p><a class="text-link" href="/chapters">Explore my chapters</a></div>
    </div>
  </section>
  <div class="scroll-cue" aria-hidden="true"><span>↓</span> <i></i> Software / games / research</div>
  <section class="life-chapters" id="life-chapters" aria-labelledby="chapters-title">
    <div class="chapter-heading" data-reveal><div><p class="overline">01 / Education &amp; work</p><h2 class="display" id="chapters-title">Chapters of my life</h2></div><a class="text-link" href="/chapters">All chapters</a></div>
    <ol class="chapter-spotlights">{chapters.map((chapter,i)=><li data-reveal><a href={`/chapters/${chapter.slug}`}><ChapterScene kind={chapter.slug}/><div class="spotlight-meta"><span>{String(i+1).padStart(2,'0')} / {chapter.category}</span><span aria-hidden="true">↗</span></div><h3 class="display">{chapter.title}</h3>{chapter.role && <p>{chapter.role}</p>}</a></li>)}</ol>
  </section>
  <section class="selected-work" id="selected-work" aria-labelledby="work-heading">
    <div class="section-heading" data-reveal><div><p class="overline">02 / What I’m building</p><h2 class="display" id="work-heading">Current projects</h2></div></div>
    <article class="feature" data-reveal><div class="feature-copy"><p class="overline">Software / 2026 – ongoing</p><h3 class="display">OpenQuire</h3><p>I’m building a PDF app for the browser and desktop. Editing, annotations, OCR, and document workflows run on your device.</p><a class="text-link" href="/projects/openquire">About OpenQuire</a><ul class="feature-tags"><li>TypeScript</li><li>WebAssembly</li><li>Local processing</li></ul></div><ProjectPreview kind="openquire" /></article>
    <article class="feature feature-reverse" data-reveal><div class="feature-copy"><p class="overline">Games &amp; graphics / 2026 – ongoing</p><h3 class="display">Ruster</h3><p>An open-source Rust engine project for interactive applications. I’m working on the renderer, scene tools, and a small application kit.</p><a class="text-link" href="/projects/ruster">About Ruster</a><ul class="feature-tags"><li>Rust</li><li>Vulkan</li><li>Early development</li></ul></div><ProjectPreview kind="ruster" /></article>
    <a class="all-projects text-link" href="/projects">Browse all projects</a>
  </section>
  <section class="research-preview" id="research-preview" aria-labelledby="research-heading" data-reveal><div><p class="overline">03 / Research direction</p><h2 class="display" id="research-heading">When a game bug<br />involves more than code.</h2><p>My proposed MSc work looks at fixes that change both source code and game assets. I want to understand how those connections can help developers find bugs.</p><a class="text-link" href="/research">Read the research proposal</a></div><ResearchDiagram /></section>
  <section class="explore" aria-labelledby="explore-heading">
    <h2 class="overline" id="explore-heading">04 / More to explore</h2>
    <ol>{paths.map(p => <li data-reveal><a class="path-link" href={p.href} aria-labelledby={`path-${p.number}`} aria-describedby={`description-${p.number}`}><span class="number" aria-hidden="true">{p.number}</span><h3 class="display" id={`path-${p.number}`}>{p.title}</h3><p id={`description-${p.number}`}>{p.description}</p><span class="arrow" aria-hidden="true">→</span></a></li>)}</ol>
  </section>
  <section class="contact-section" data-reveal aria-labelledby="contact-heading"><h2 class="display" id="contact-heading">Get in touch</h2><div><p>You can email me about research, working together, or anything on this site.</p><a class="text-link" href="mailto:mail@akilfernando.dev">Email me</a></div></section>
</BaseLayout>
<style>
.life-chapters { padding-block:3.5rem 4rem;border-bottom:1px solid var(--ink);scroll-margin-top:2rem; }.chapter-heading { display:flex;align-items:end;justify-content:space-between;gap:1.5rem;margin-bottom:2.5rem; }.chapter-heading h2 { font-size:clamp(2.5rem,5vw,4rem);margin-top:1rem; }.chapter-heading .text-link { flex-shrink:0; }.chapter-spotlights { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2.5rem 1.5rem;list-style:none;padding:0; }.chapter-spotlights a { display:block;text-decoration:none; }.spotlight-meta { display:flex;justify-content:space-between;font:.65rem var(--font-mono);color:var(--accent);padding-block:1rem; }.spotlight-meta span:last-child { transition:transform .3s; }.chapter-spotlights a:hover .spotlight-meta span:last-child,.chapter-spotlights a:focus-visible .spotlight-meta span:last-child { transform:translate(4px,-4px); }.chapter-spotlights h3 { font-size:clamp(1.5rem,2.5vw,2rem); }.chapter-spotlights li p { font-size:.75rem;color:var(--ink-muted);margin-top:.75rem; }
@media(max-width:850px) { .chapter-spotlights { grid-template-columns:repeat(2,minmax(0,1fr)); } }
@media(max-width:500px) { .life-chapters { padding-block:2.5rem; }.chapter-heading { align-items:start;flex-direction:column;gap:.5rem; }.chapter-spotlights { gap:2rem 1rem; }.chapter-spotlights h3 { font-size:1.3rem; }.chapter-spotlights li p { font-size:.7rem; }.spotlight-meta { font-size:.6rem; } }

.page-index { display: flex; flex-wrap:wrap; gap: .5rem 1.5rem; font: .65rem var(--font-mono); padding-bottom: 2.5rem; color: var(--ink-muted); }.page-index a { text-decoration: none; padding-block: .5rem; }.page-index a:hover { color: var(--accent); }.page-index span { margin-left: auto; padding-block: .5rem; }
.scroll-cue { display: flex; align-items: center; gap: 1rem; font: .65rem var(--font-mono); color: var(--ink-muted); padding-block: 1.5rem; }.scroll-cue > span { font-size: 1.2rem; color: var(--accent); }.scroll-cue i { flex: 1; height: 1px; background: var(--rule); margin-inline: 1rem; }
.selected-work { padding-top: 5rem; scroll-margin-top: 2rem; }.section-heading { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-bottom: 3rem; }.section-heading h2 { font-size: clamp(2.5rem,5vw,4rem); margin-top: 1rem; }.section-heading > p { max-width: 27ch; color: var(--ink-muted); font-size: .85rem; }
.feature { display: grid; grid-template-columns: .85fr 1.15fr; align-items: start; gap: clamp(2rem,5vw,5rem); padding-block: 3rem 5rem; border-top: 1px solid var(--rule); }.feature-copy { position: sticky; top: 3rem; padding-top: 1.5rem; }.feature h3 { font-size: clamp(2.75rem,5vw,4.5rem); margin-top: 1rem; }.feature-copy > p:not(.overline) { max-width: 39ch; color: var(--ink-muted); font-size: .95rem; margin-top: 1.5rem; }.feature .text-link { margin-top: 1.5rem; }.feature-tags { display: flex; flex-wrap: wrap; gap: .5rem 1rem; list-style: none; margin-top: 2rem; font: .65rem var(--font-mono); color: var(--ink-muted); }.feature-tags li { border-bottom: 1px solid var(--rule); padding-bottom: .4rem; }.feature-reverse { grid-template-columns: 1.15fr .85fr; min-height: 115vh; }.feature-reverse :global(.project-preview) { position: sticky; top: 12vh; }.feature-reverse .feature-copy { grid-column: 2; grid-row: 1; }.feature-reverse :global(.project-preview) { grid-column: 1; grid-row: 1; }.all-projects { margin-bottom: 4rem; }
.research-preview { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 5rem; padding: 4rem 0; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--rule); scroll-margin-top: 2rem; }.research-preview h2 { font-size: clamp(2rem,4vw,3.25rem); margin-top: 1rem; }.research-preview > div > p:not(.overline) { max-width: 43ch; color: var(--ink-muted); font-size: .9rem; margin-top: 1.5rem; }.research-preview .text-link { margin-top: 1.5rem; }.research-preview :global(.research-diagram) { margin-inline: auto; }
@media(max-width:750px) { .page-index { gap: 1rem; padding-bottom: 1.5rem; }.page-index span { display: none; }.scroll-cue { font-size: .6rem; flex-wrap: wrap; }.scroll-cue i { margin: 0; }.selected-work { padding-top: 3rem; }.section-heading { align-items: start; flex-direction: column; gap: 1rem; }.section-heading > p { max-width: 45ch; }.feature,.feature-reverse { grid-template-columns: 1fr; gap: 2rem; padding-block: 2rem 3rem; }.feature-copy { position: static; padding-top: 0; }.feature-reverse { min-height: auto; }.feature-reverse .feature-copy,.feature-reverse :global(.project-preview) { grid-column: auto; grid-row: auto; position: static; }.feature-copy > p:not(.overline) { max-width: 50ch; }.feature-tags { margin-top: 1rem; }.research-preview { grid-template-columns: 1fr; gap: 2.5rem; padding-block: 3rem; } }

.hero { padding-top: .5rem; padding-bottom: 4rem; border-bottom: 1px solid var(--ink); }
.hero-top { display: flex; justify-content: space-between; gap: 1rem; }
.location { font-family: var(--font-mono); font-size: .7rem; color: var(--ink-muted); }
.hero-grid { display: grid; grid-template-columns: 1.45fr 1fr; gap: 4rem; align-items: center; padding-top: 3rem; }
h1 { font-size: var(--fs-display); line-height: .94; letter-spacing: -.065em; }
h1 span { color: var(--accent); }
.hero-copy { font-family: var(--font-display); font-size: clamp(1.5rem, 2.8vw, 2.2rem); line-height: 1.3; letter-spacing: -.025em; margin-top: 2rem; }
.introduction > p:not(.overline) { color: var(--ink-muted); font-size: 1rem; line-height: 1.8; max-width: 40ch; margin-top: 1.25rem; }
.introduction .text-link { margin-top: 1.5rem; }
.explore { padding-top: 3rem; }
.explore > h2 { margin-bottom: 1.5rem; }
ol { list-style: none; padding: 0; }
.path-link { display: grid; grid-template-columns: 2rem 1fr 1.3fr 2rem; align-items: center; gap: 1.5rem; padding: 2rem .5rem; border-bottom: 1px solid var(--rule); text-decoration: none; }
.number { color: var(--ink-muted); font: .7rem var(--font-mono); }
.path-link h3 { font-size: clamp(1.8rem, 3vw, 2.6rem); }
.path-link p { font-size: .875rem; color: var(--ink-muted); max-width: 43ch; }
.arrow { color: var(--accent); font-size: 1.25rem; transition: transform .18s ease; }
.path-link:hover, .path-link:focus-visible { background: var(--accent-tint); }
.path-link:hover h3, .path-link:focus-visible h3 { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .2em; }
.path-link:hover .arrow { transform: translateX(4px); }
.contact-section { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; padding-top: 4rem; align-items: start; }
.contact-section h2 { font-size: clamp(2.5rem, 4.5vw, 4rem); }
.contact-section p { font-size: .875rem; color: var(--ink-muted); max-width: 40ch; }
.contact-section .text-link { margin-top: 1rem; }
@media (max-width: 700px) {
 .hero { padding-bottom: 2.5rem; }
 .hero-grid { grid-template-columns: 1fr; gap: 2.5rem; padding-top: 2rem; }
 .introduction > p:not(.overline) { max-width: 55ch; }
 .path-link { grid-template-columns: 1.5rem 1fr 1.5rem; gap: .75rem; padding-block: 1.5rem; }
 .path-link p { grid-column: 2; grid-row: 2; }
 .arrow { grid-column: 3; grid-row: 1; }
 .contact-section { grid-template-columns: 1fr; gap: 1.5rem; padding-top: 3rem; }
}
</style>
