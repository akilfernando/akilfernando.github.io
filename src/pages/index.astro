---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, socials } from '../config';
const paths = [
  { number: '01', title: 'Research', href: '/research', description: 'My proposed graduate work and the questions I want to investigate.' },
  { number: '02', title: 'Projects', href: '/projects', description: 'Software, games, and tools I have built, with the decisions behind them.' },
  { number: '03', title: 'Background', href: '/career', description: 'Professional experience, education, and CVs.' },
];
const personSchema = { '@context': 'https://schema.org', '@type': 'Person', name: site.name, url: site.url, alumniOf: { '@type': 'CollegeOrUniversity', name: 'Dalhousie University' }, sameAs: socials.filter(s => s.href.startsWith('http')).map(s => s.href) };
---
<BaseLayout description="Akil Fernando: software engineer and incoming Computer Science MSc student at the University of Calgary, with experience in games, IT, and cybersecurity.">
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <section class="hero" aria-labelledby="identity">
    <div class="hero-top"><p class="eyebrow">Engineering &amp; research</p><p class="location">Colombo, Sri Lanka</p></div>
    <div class="hero-grid">
      <div><h1 class="display" id="identity">Akil<br />Fernando<span>.</span></h1><p class="hero-copy">Software engineer.<br />A new chapter in research.</p></div>
      <div class="introduction"><p class="overline">A little about me</p><p>I build software and work with the systems around it. My background spans game development, IT operations, and cybersecurity.</p><p>Now, I’m bringing that experience into graduate research as an incoming MSc student in Computer Science at the University of Calgary.</p><a class="text-link" href="/about">More about me</a></div>
    </div>
  </section>
  <section class="explore" aria-labelledby="explore-heading">
    <h2 class="overline" id="explore-heading">Explore my work</h2>
    <ol>{paths.map(p => <li><a class="path-link" href={p.href} aria-labelledby={`path-${p.number}`} aria-describedby={`description-${p.number}`}><span class="number" aria-hidden="true">{p.number}</span><h3 class="display" id={`path-${p.number}`}>{p.title}</h3><p id={`description-${p.number}`}>{p.description}</p><span class="arrow" aria-hidden="true">→</span></a></li>)}</ol>
  </section>
  <section class="contact-section" aria-labelledby="contact-heading"><h2 class="display" id="contact-heading">Let’s talk.</h2><div><p>For research conversations, collaborations, or a question about my work.</p><a class="text-link" href="mailto:mail@akilfernando.dev">Email me</a></div></section>
</BaseLayout>
<style>
.hero { padding-top: .5rem; padding-bottom: 4rem; border-bottom: 1px solid var(--ink); }
.hero-top { display: flex; justify-content: space-between; gap: 1rem; }
.location { font-family: var(--font-mono); font-size: .7rem; color: var(--ink-muted); }
.hero-grid { display: grid; grid-template-columns: 1.45fr 1fr; gap: 4rem; align-items: center; padding-top: 3rem; }
h1 { font-size: var(--fs-display); line-height: .94; letter-spacing: -.065em; }
h1 span { color: var(--accent); }
.hero-copy { font-family: var(--font-display); font-size: clamp(1.5rem, 2.8vw, 2.2rem); line-height: 1.3; letter-spacing: -.025em; margin-top: 2rem; }
.introduction > p:not(.overline) { color: var(--ink-muted); font-size: 1rem; line-height: 1.8; max-width: 40ch; margin-top: 1.25rem; }
.introduction .text-link { margin-top: 1.5rem; }
.explore { padding-top: 3rem; }
.explore > h2 { margin-bottom: 1.5rem; }
ol { list-style: none; padding: 0; }
.path-link { display: grid; grid-template-columns: 2rem 1fr 1.3fr 2rem; align-items: center; gap: 1.5rem; padding: 2rem .5rem; border-bottom: 1px solid var(--rule); text-decoration: none; }
.number { color: var(--ink-muted); font: .7rem var(--font-mono); }
.path-link h3 { font-size: clamp(1.8rem, 3vw, 2.6rem); }
.path-link p { font-size: .875rem; color: var(--ink-muted); max-width: 43ch; }
.arrow { color: var(--accent); font-size: 1.25rem; transition: transform .18s ease; }
.path-link:hover, .path-link:focus-visible { background: var(--accent-tint); }
.path-link:hover h3, .path-link:focus-visible h3 { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .2em; }
.path-link:hover .arrow { transform: translateX(4px); }
.contact-section { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; padding-top: 4rem; align-items: start; }
.contact-section h2 { font-size: clamp(2.5rem, 4.5vw, 4rem); }
.contact-section p { font-size: .875rem; color: var(--ink-muted); max-width: 40ch; }
.contact-section .text-link { margin-top: 1rem; }
@media (max-width: 700px) {
 .hero { padding-bottom: 2.5rem; }
 .hero-grid { grid-template-columns: 1fr; gap: 2.5rem; padding-top: 2rem; }
 .introduction > p:not(.overline) { max-width: 55ch; }
 .path-link { grid-template-columns: 1.5rem 1fr 1.5rem; gap: .75rem; padding-block: 1.5rem; }
 .path-link p { grid-column: 2; grid-row: 2; }
 .arrow { grid-column: 3; grid-row: 1; }
 .contact-section { grid-template-columns: 1fr; gap: 1.5rem; padding-top: 3rem; }
}
</style>
