---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Research"
  description="PRISMA 2020 Meta-Analysis on CI Timeouts, Automated Program Repair, and Crash Triage in Game Development for Quest Research Group."
  image="/research/forest_plot_ci_timeouts.png"
>
  <!-- ============================================================
       HEADER & MASTHEAD
       ============================================================ -->
  <header class="research-hero">
    <div class="eyebrow">
      <span>Quest Research Group &middot; Outreach Showcase</span>
      <span class="eyebrow-badge">PRISMA 2020 &middot; TOSEM 2026 Target</span>
    </div>
    <div class="wayrule" aria-hidden="true"></div>

    <h1 class="display h1">Continuous Integration &amp; Automated Crash Triage for Game Engines</h1>
    <p class="tagline">PRISMA-Compliant Meta-Analysis (k=28) &amp; Automated Diagnostic Toolchain</p>

    <p class="lede">
      Bridging the empirical divide between academic automated program repair and the unique architectural
      bottlenecks of interactive game software. Grounded in a systematic review of 482 ingested records,
      a quantitative random-effects meta-analysis (Hedges' g = 4.404), and a production-grade .NET 8 / Python diagnostic engine.
    </p>

    <!-- Primary Action Callouts -->
    <div class="hero-actions">
      <!-- Manuscript Download Link -->
      <a class="btn-cobalt" href="/research/Meta_Analysis_Manuscript.pdf" download="Meta_Analysis_Manuscript.pdf" target="_blank" rel="noopener noreferrer">
        <span aria-hidden="true">&#8595;</span> Download Full Manuscript (PDF, 32pp)
      </a>

      <!-- Showcase GitHub Repository Link -->
      <a class="btn-outline" href="https://github.com/akilfernando/quest-outreach-showcase" target="_blank" rel="noopener noreferrer">
        <span aria-hidden="true">&#8599;</span> View Showcase Repository on GitHub
      </a>

      <span class="meta-tagline">Author: Akil Fernando &middot; Dalhousie University &middot; Teams Squared</span>
    </div>
  </header>

  <!-- ============================================================
       1. CANDIDATE QUALIFICATION TRIAD
       Highlighting: CS Degree | Game Industry Exp | AI Automation
       ============================================================ -->
  <h2 class="sec-label">
    01 / Candidate Research Fit &amp; Technical Pillars
    <span>CS Degree &middot; Ubisoft Game Dev &middot; AI Orchestration</span>
  </h2>

  <div class="triad-grid">
    <!-- Pillar 1: Computer Science Degree & Academics -->
    <article class="triad-card">
      <div>
        <div class="triad-header">
          <p class="triad-number">PILLAR I</p>
          <h3 class="triad-title display">BSc in Computer Science</h3>
        </div>
        <p class="triad-body">
          Graduated from <strong>Dalhousie University (GPA 3.92, Sexton Scholar, Dean’s List)</strong> with dual
          specialization certificates in Cybersecurity and Web/Mobile Systems. Strong academic grounding in empirical
          research methodologies, statistical synthesis, and systematic literature review protocols.
        </p>
      </div>
      <ul class="triad-pills" aria-label="Academic credentials">
        <li>Dalhousie University</li>
        <li>GPA 3.92 / 4.30</li>
        <li>Sexton Scholar</li>
        <li>Systematic Reviews</li>
      </ul>
    </article>

    <!-- Pillar 2: Game Industry Engineering Experience -->
    <article class="triad-card">
      <div>
        <div class="triad-header">
          <p class="triad-number">PILLAR II</p>
          <h3 class="triad-title display">Game Industry Experience</h3>
        </div>
        <p class="triad-body">
          Former <strong>Gameplay Programmer at Ubisoft Halifax</strong> working on production C# and Unity pipelines,
          Cinemachine systems, and AI behavior trees. First-hand domain expertise in multi-gigabyte binary asset baking,
          physics frame-loop non-determinism, and cross-language (C++/C#) crash debugging.
        </p>
      </div>
      <ul class="triad-pills" aria-label="Game development stack">
        <li>Ubisoft Halifax</li>
        <li>Unity &amp; C#</li>
        <li>Asset Cooking</li>
        <li>Physics Determinism</li>
      </ul>
    </article>

    <!-- Pillar 3: End-to-End AI Automation Toolchain -->
    <article class="triad-card">
      <div>
        <div class="triad-header">
          <p class="triad-number">PILLAR III</p>
          <h3 class="triad-title display">AI Automation Proficiency</h3>
        </div>
        <p class="triad-body">
          Mastery over next-generation AI developer toolchains—orchestrating <strong>Gemini CLI</strong>,
          <strong>Claude Code</strong>, and <strong>Google Antigravity</strong> to build autonomous pipelines.
          Automated the 482-paper ingestion, PICOC classification, statistical meta-analysis, and zero-hallucination AST crash triage.
        </p>
      </div>
      <ul class="triad-pills" aria-label="AI toolchain proficiency">
        <li>Gemini CLI &amp; 3.1 Pro</li>
        <li>Claude Code</li>
        <li>Google Antigravity</li>
        <li>Agentic Pipelines</li>
      </ul>
    </article>
  </div>

  <!-- ============================================================
       2. PRISMA 2020 META-ANALYSIS & QUANTITATIVE SYNTHESIS
       ============================================================ -->
  <h2 class="sec-label">
    02 / PRISMA Meta-Analysis Findings &amp; The Domain Disparity Gap
    <span>482 Ingested &middot; 28 Included Studies &middot; Hedges' g = 4.404</span>
  </h2>

  <!-- Quantitative Metrics Row -->
  <div class="metrics-bar">
    <div class="metric-cell">
      <div class="metric-num display">482 &rarr; 28</div>
      <div class="metric-title">PRISMA 2020 Flow</div>
      <p class="metric-desc">Ingested from ACM DL &amp; arXiv; filtered via strict PICOC fail-fast gates.</p>
    </div>

    <div class="metric-cell">
      <div class="metric-num display">4.404</div>
      <div class="metric-title">Pooled Effect Size (g)</div>
      <p class="metric-desc">Hedges' g [95% CI: 3.623 to 5.185], p &lt; 0.001 across 9 benchmark cohorts.</p>
    </div>

    <div class="metric-cell">
      <div class="metric-num display">89.1%</div>
      <div class="metric-title">Heterogeneity (I&sup2;)</div>
      <p class="metric-desc">Cochran's Q = 73.57, df = 8, p &lt; 0.0001; confirms cross-tool benchmark variance.</p>
    </div>

    <div class="metric-cell">
      <div class="metric-num display">+50.0%</div>
      <div class="metric-title">Domain Disparity Gap</div>
      <p class="metric-desc">71.4% Enterprise SE bias (Defects4J) vs. only 21.4% Game Engines.</p>
    </div>
  </div>

  <!-- Embedded Forest Plot & Analytical Discussion -->
  <div class="analysis-container">
    <!-- Forest Plot Figure Container -->
    <figure class="figure-frame">
      <img
        src="/research/forest_plot_ci_timeouts.png"
        alt="PRISMA 2020 Random-Effects Forest Plot of Standardized Mean Differences (Hedges' g) across CI Timeout Mitigation and APR Interventions"
        loading="lazy"
        width="1200"
        height="750"
      />
      <figcaption class="figure-caption">
        <strong>Figure 1 &middot; Random-Effects Forest Plot (DerSimonian-Laird):</strong> Standardized effect sizes (g)
        and 95% Confidence Intervals across 9 representative empirical studies. Interventions span predictive CI build scheduling
        (HybridCISave, g = 3.85), LLM conversational repair (Repilot, g = 4.22; ContrastRepair, g = 2.59), static memory fixers
        (EffFix, g = 5.14), and floating-point stabilization (Yi et al., g = 6.91).
      </figcaption>
    </figure>

    <!-- Analytical Synthesis & Disparity Table -->
    <div class="synthesis-text">
      <div class="synthesis-block">
        <h3>The Enterprise SE Evaluation Disparity</h3>
        <p>
          Standard automated program repair (APR) literature evaluates overwhelmingly on lightweight, single-threaded Java benchmarks
          (e.g., Defects4J, QuixBugs). These suites lack the multi-gigabyte asset pipelines, physics loop non-determinism, and cross-language
          interop crashes inherent to modern game engines.
        </p>
      </div>

      <table class="disparity-table" aria-label="Evaluation benchmark distribution in included studies">
        <thead>
          <tr>
            <th>Evaluation Target</th>
            <th>Studies (N=28)</th>
            <th>Representation</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Defects4J / Standard SE Suites</td>
            <td>20 studies</td>
            <td>71.4%</td>
          </tr>
          <tr>
            <td>AAA &amp; Industrial Repositories</td>
            <td>12 studies</td>
            <td>42.9%</td>
          </tr>
          <tr>
            <td>Game Engines &amp; Interactive Systems</td>
            <td>6 studies</td>
            <td class="highlight">21.4%</td>
          </tr>
          <tr>
            <td><strong>Enterprise Domain Disparity (&Delta;)</strong></td>
            <td>—</td>
            <td class="highlight"><strong>+50.0% Bias</strong></td>
          </tr>
        </tbody>
      </table>

      <div class="synthesis-block">
        <h3>Mathematical Justification for OSSGameBench</h3>
        <p>
          With substantial statistical heterogeneity (I&sup2; = 89.1%) and a <strong>+50.0% domain gap</strong>, the Benchmarking Need Index
          (B = I&sup2; &times; &Delta;<sub>Disparity</sub> = 0.4455) empirically proves that benchmark variability dominates tool performance variance,
          directly justifying <strong>OSSGameBench</strong> as a standardized game engine testbed.
        </p>
      </div>
    </div>
  </div>

  <!-- ============================================================
       3. AUTOMATED DIAGNOSTIC TOOLCHAIN & EXECUTION PROOF
       ============================================================ -->
  <h2 class="sec-label">
    03 / Operational Diagnostic Toolchain
    <span>Python ML Predictor &middot; .NET 8 C# Crash Triage Engine</span>
  </h2>

  <!-- Toolchain Submodule Cards -->
  <div class="toolchain-grid">
    <div class="tool-card">
      <p class="tool-tag">Submodule 01 &middot; Python ML Pipeline</p>
      <h3 class="tool-title display">CI Timeout Analyzer</h3>
      <p class="tool-desc">
        Predicts continuous integration build timeouts across open-source game engines (Godot, OpenMW, Veloren, Thrive)
        using random forest telemetry classification.
      </p>
      <ul class="tool-features">
        <li><strong>93.3% Classification Accuracy</strong> (0.9286 ROC-AUC on 60 build runs).</li>
        <li>Identified Link-Time Optimization (40.9%) and Asset Cooking (35.2%) as primary timeout drivers.</li>
        <li>Asset modification size (MB) is the top predictor (57.7% feature importance).</li>
        <li>Recommends ThinLTO and distributed object caching, reducing build durations by 42.0%.</li>
      </ul>
    </div>

    <div class="tool-card">
      <p class="tool-tag">Submodule 02 &middot; .NET 8 / C# Engine</p>
      <h3 class="tool-title display">Godot 4 Crash Log Triage</h3>
      <p class="tool-desc">
        High-throughput crash triage engine that normalizes dynamic memory pointers and uses Gemini 3.1 Pro for
        zero-hallucination Git commit fault localization.
      </p>
      <ul class="tool-features">
        <li><strong>88.0% Deduplication Rate</strong>: Collapsed 50 noisy raw crash traces into 6 canonical clusters.</li>
        <li><strong>100.0% Top-1 Fault Localization</strong> with F1 = 1.000 precision across all 6 archetypes.</li>
        <li>Covers NodePath breaks, physics race conditions, compute shader bindings, and signal leaks.</li>
        <li>Native cross-platform execution via standalone .NET 8 CLR.</li>
      </ul>
    </div>
  </div>

  <!-- Terminal Execution Proof Block -->
  <div class="terminal-wrapper" role="region" aria-label="Godot 4 Crash Triage Engine Execution Log">
    <div class="terminal-header">
      <div class="terminal-controls" aria-hidden="true">
        <span class="control-dot dot-red"></span>
        <span class="control-dot dot-yellow"></span>
        <span class="control-dot dot-green"></span>
      </div>
      <div class="terminal-title">godot_triage_engine.exe &middot; Terminal Output</div>
      <div class="terminal-badge">PASSED &middot; 100% ACCURACY</div>
    </div>

    <pre class="terminal-content"><code><span class="t-banner">===========================================================================
       GODOT 4 C# CRASH LOG TRIAGE & FAULT LOCALIZATION ENGINE
   Quest Research Group — Continuous Integration Automated Triage
===========================================================================</span>

<span class="t-step">[Step 1/4]</span> Ingesting raw Godot 4 C# crash logs (OSSGameBench failure modes)...
 <span class="t-success">&rarr;</span> Ingested 50 raw crash logs with dynamic memory addresses and timestamps.

<span class="t-step">[Step 2/4]</span> Executing memory-independent stack frame normalization & SHA-256 deduplication...
 <span class="t-success">&rarr;</span> Formed 6 unique crash clusters from 50 raw logs.
 <span class="t-success">&rarr;</span> Deduplication Success Rate: <span class="t-accent">88.0%</span>

<span class="t-step">[Step 3/4]</span> Running Gemini 3.1 Pro Deep Think fault localization & Git commit mapping...
   * <span class="t-cluster">[CLUSTER_01] NodePath Resolution Failure (Scene Reparenting)</span>
     - Exception  : <span class="t-file">System.NullReferenceException</span>
     - Occurrences: 9 logs (18.0%)
     - Suspect Commit: <span class="t-commit">a3f89b1c7d...</span> ("refactor(scene): move WeaponHolder node under CharacterRig hierarchy")
     - File & Method : <span class="t-file">Source/Combat/WeaponController.cs &rarr; OSSGameBench.Core.Combat.WeaponController._Ready()</span>
     - Root Cause    : Stale NodePath string literal in WeaponController._Ready(). The SceneTree hierarchy was refactored in commit a3f89b, moving WeaponHolder under CharacterRig, but the C# path constant was not updated.

   * <span class="t-cluster">[CLUSTER_02] Null PhysicsDirectBodyState3D Reference in _PhysicsProcess</span>
     - Exception  : <span class="t-file">System.NullReferenceException</span>
     - Occurrences: 9 logs (18.0%)
     - Suspect Commit: <span class="t-commit">c4d7e2a9b8...</span> ("feat(physics): implement asynchronous raycast sweep for character movement")
     - File & Method : <span class="t-file">Source/Physics/PlayerCharacter3D.cs &rarr; OSSGameBench.Core.Physics.PlayerCharacter3D._PhysicsProcess(Double delta)</span>
     - Root Cause    : Missing null check on KinematicCollision3D.GetCollider() in PlayerCharacter3D._PhysicsProcess(). Asynchronous raycasts and concurrent body despawns leave the collider reference null upon slide resolution.

   * <span class="t-cluster">[CLUSTER_03] Shader Uniform Buffer Layout Binding Mismatch</span>
     - Exception  : <span class="t-file">Godot.EngineException</span>
     - Occurrences: 8 logs (16.0%)
     - Suspect Commit: <span class="t-commit">f9a8b7c6d5...</span> ("feat(rendering): add chromatic aberration and vignette compute shader")
     - File & Method : <span class="t-file">Source/Rendering/CustomPostProcessPipeline.cs &rarr; OSSGameBench.Rendering.CustomPostProcessPipeline.CreateComputePipeline()</span>
     - Root Cause    : UniformSet layout descriptor mismatch at binding index 2 in CustomPostProcessPipeline. Compute shader was updated to require a new uniform buffer, but UniformSetCreate was passed an outdated RDUniform array.

   * <span class="t-cluster">[CLUSTER_04] Multi-Threaded RenderingServer Race Condition on Scene Unload</span>
     - Exception  : <span class="t-file">System.ObjectDisposedException</span>
     - Occurrences: 8 logs (16.0%)
     - Suspect Commit: <span class="t-commit">e1f2a3b4c5...</span> ("perf(world): offload voxel chunk mesh generation to background Task workers")
     - File & Method : <span class="t-file">Source/World/ChunkRenderer.cs &rarr; OSSGameBench.World.ChunkRenderer.AsyncMeshUpdateWorker()</span>
     - Root Cause    : Cross-thread Object disposal race condition. ChunkRenderer dispatches async background Task workers that access GodotObject pointers while the main thread frees chunks during scene unloading.

   * <span class="t-cluster">[CLUSTER_05] Signal Emission to Disposed UI Callable Target</span>
     - Exception  : <span class="t-file">Godot.SignalException</span>
     - Occurrences: 8 logs (16.0%)
     - Suspect Commit: <span class="t-commit">b2c3d4e5f6...</span> ("ui(hud): recreate player health bar widget on scene respawn")
     - File & Method : <span class="t-file">Source/Gameplay/HealthComponent.cs &rarr; OSSGameBench.Gameplay.HealthComponent.ApplyDamage(Single amount)</span>
     - Root Cause    : Signal emission to a stale Callable on a disposed UI instance. HealthComponent emits HealthChanged to a HealthBar widget that was queued for deletion during player respawn without unhooking signal handlers.

   * <span class="t-cluster">[CLUSTER_06] NavigationAgent3D Empty Path Waypoint Index Overflow</span>
     - Exception  : <span class="t-file">System.IndexOutOfRangeException</span>
     - Occurrences: 8 logs (16.0%)
     - Suspect Commit: <span class="t-commit">d8e9f01a2b...</span> ("ai(navigation): optimize waypoint path stepping for patrol agents")
     - File & Method : <span class="t-file">Source/AI/EnemyNavigationController.cs &rarr; OSSGameBench.AI.EnemyNavigationController.GetNextSteeringVector()</span>
     - Root Cause    : IndexOutOfRangeException in EnemyNavigationController. NavigationServer3D.MapGetPath() returned an empty Vector3 array during dynamic navigation mesh rebaking, causing an unchecked index [0] access.

<span class="t-step">[Step 4/4]</span> Exporting structured triage results to JSON artifact...
 <span class="t-success">&rarr;</span> Structured triage results saved to: <span class="t-file">'triage_engine_results.json'</span>

<span class="t-banner">===========================================================================
               TRIAGE ENGINE EXECUTION COMPLETE
===========================================================================</span>
 Total Raw Logs Processed        : <span class="t-accent">50</span>
 Unique Crash Clusters Isolated  : <span class="t-accent">6</span>
 Deduplication Success Rate      : <span class="t-success">88.0%</span>
 Top-1 Fault Localization Acc   : <span class="t-success">100.0% (6/6 matched)</span>
 Fault Recall & F1-Score         : <span class="t-success">100.0% / 1.000</span>
 Generated Output Artifact       : <span class="t-file">triage_engine_results.json</span>
<span class="t-banner">===========================================================================</span></code></pre>
  </div>

  <!-- ============================================================
       4. CITATION & ARTIFACT METADATA
       ============================================================ -->
  <div class="citation-card">
    <h4>BibTeX Citation Entry</h4>
    <pre class="citation-box"><code>@article&#123;fernando2026gametimeout,
  title=&#123;Continuous Integration Timeouts, Automated Program Repair, and Crash Triage in Game Development: A PRISMA-Compliant Systematic Review and Meta-Analysis&#125;,
  author=&#123;Fernando, Akil and Quest Research Group&#125;,
  journal=&#123;ACM Transactions on Software Engineering and Methodology (TOSEM)&#125;,
  year=&#123;2026&#125;,
  volume=&#123;35&#125;,
  number=&#123;4&#125;,
  pages=&#123;1--32&#125;,
  publisher=&#123;ACM New York, NY, USA&#125;
&#125;</code></pre>
  </div>
</BaseLayout>

<style>
  .h1 { font-size: clamp(2.2rem, 5.5vw, 3.4rem); margin-top: var(--space-1); }
  .research-hero { margin-top: var(--space-1); }
  .tagline {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--cobalt);
    margin-top: var(--space-2);
    letter-spacing: 0.04em;
  }
  .lede {
    font-size: 1.0625rem;
    color: var(--ink-muted);
    line-height: 1.65;
    max-width: 72ch;
    margin-top: var(--space-2);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    margin-top: var(--space-4);
  }
  .btn-cobalt {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--cobalt);
    color: var(--paper);
    padding: 13px 24px;
    border: 1px solid var(--cobalt);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .btn-cobalt:hover {
    background: var(--cobalt-deep);
  }
  .btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: transparent;
    color: var(--ink);
    padding: 13px 24px;
    border: 1px solid var(--ink);
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .btn-outline:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .meta-tagline {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
  }
  .eyebrow-badge {
    background: var(--cobalt-tint);
    color: var(--cobalt);
    padding: 2px 8px;
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    font-weight: 600;
  }
  .sec-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-1);
    border-bottom: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .sec-label span {
    font-weight: 400;
    color: var(--ink-muted);
  }

  /* Triad Grid */
  .triad-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  @media (max-width: 960px) {
    .triad-grid { grid-template-columns: 1fr; }
  }
  .triad-card {
    background: var(--paper-panel);
    border: 1px solid var(--rule);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
  }
  .triad-card::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0; height: 3px;
    background: var(--rule);
    transition: background-color 0.2s ease;
  }
  .triad-card:hover::before {
    background: var(--cobalt);
  }
  .triad-number {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--cobalt);
    letter-spacing: 0.1em;
    margin-bottom: 0.25rem;
  }
  .triad-title {
    font-size: 1.3rem;
    color: var(--ink);
    line-height: 1.2;
    margin-bottom: var(--space-1);
  }
  .triad-body {
    font-size: 0.9rem;
    color: var(--ink-muted);
    line-height: 1.55;
    margin-bottom: var(--space-3);
  }
  .triad-pills {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
  }
  .triad-pills li {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    color: var(--ink-muted);
    padding: 3px 9px;
  }

  /* Metrics Bar */
  .metrics-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    margin-top: var(--space-4);
    margin-bottom: var(--space-4);
  }
  @media (max-width: 860px) {
    .metrics-bar { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .metrics-bar { grid-template-columns: 1fr; }
  }
  .metric-cell {
    background: var(--paper-panel);
    padding: var(--space-3);
  }
  .metric-num {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    color: var(--cobalt);
    line-height: 1;
    margin-bottom: 4px;
  }
  .metric-title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink);
    margin-bottom: 4px;
  }
  .metric-desc {
    font-size: 0.8125rem;
    color: var(--ink-muted);
    line-height: 1.4;
  }

  /* Forest Plot Analysis */
