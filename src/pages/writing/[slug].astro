---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const pieces = await getCollection('writing', ({ data }) => !data.draft);
  return pieces.map((piece) => ({ params: { slug: piece.slug }, props: { piece } }));
}

type Props = { piece: CollectionEntry<'writing'> };
const { piece } = Astro.props;
const { Content } = await piece.render();
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<BaseLayout
  title={piece.data.title}
  description={piece.data.description}
  type="article"
  publishedTime={piece.data.date.toISOString()}
>
  <!-- Reading Progress Bar at the top of viewport -->
  <div class="reading-progress-track" aria-hidden="true">
    <div class="reading-progress-bar" id="reading-progress-bar"></div>
  </div>

  <p class="eyebrow">Writing</p>
  <div class="wayrule"></div>

  <article class="article" data-slug={piece.slug}>
    <p class="meta">
      <span class="date">{fmt(piece.data.date)}</span>
      {piece.data.status && <span class="status">{piece.data.status}</span>}
    </p>

    <h1 class="display title">{piece.data.title}</h1>

    {piece.data.tags.length > 0 && (
      <ul class="tags" aria-label="Tags">
        {piece.data.tags.map((t) => <li>{t}</li>)}
      </ul>
    )}

    <!-- Resume Reading Notification Banner -->
    <div class="resume-banner" id="resume-banner" hidden>
      <div class="resume-info">
        <span class="resume-icon" aria-hidden="true">🔖</span>
        <div class="resume-text">
          <span class="resume-label">Saved Bookmark</span>
          <span class="resume-heading" id="resume-heading">Chapter</span>
          <span class="resume-pct" id="resume-pct">(0%)</span>
        </div>
      </div>
      <div class="resume-actions">
        <button type="button" class="btn-resume" id="btn-resume">Resume reading &rarr;</button>
        <button type="button" class="btn-clear-bm" id="btn-clear-bm" title="Clear bookmark">Start over</button>
      </div>
    </div>

    <!-- Chapter Quick Jump & Reading Control Bar -->
    <div class="reading-toolbar" id="reading-toolbar" hidden>
      <div class="chapter-nav-wrapper">
        <button type="button" class="chapter-menu-btn" id="chapter-menu-btn" aria-haspopup="true" aria-expanded="false">
          <span class="chapter-tag">Chapter</span>
          <span class="current-chapter-title" id="current-chapter-title">Select chapter...</span>
          <span class="chevron" aria-hidden="true">&#9662;</span>
        </button>

        <!-- Dropdown Menu -->
        <div class="chapter-dropdown" id="chapter-dropdown" hidden>
          <div class="chapter-dropdown-header">
            <span>Skip to Chapter</span>
            <span class="chapter-count" id="chapter-count"></span>
          </div>
          <ul class="chapter-list" id="chapter-list" role="menu">
            <!-- Populated via client-side JavaScript -->
          </ul>
        </div>
      </div>

      <div class="toolbar-meta">
        <span class="read-pct-badge" id="read-pct-badge">0% read</span>
        
        <!-- Open Annotations Drawer Button -->
        <button type="button" class="tool-btn notes-drawer-btn" id="open-notes-btn" title="View all annotations & notes">
          <span class="tool-icon">📝</span>
          <span class="notes-count-label" id="notes-count-label">Notes (0)</span>
        </button>

        <!-- Quick Bookmark Button -->
        <button type="button" class="tool-btn quick-bm-btn" id="quick-bm-btn" title="Save current position as bookmark">
          <span class="tool-icon" id="quick-bm-icon">🔖</span>
          <span class="bm-text" id="quick-bm-text">Bookmark</span>
        </button>
      </div>
    </div>

    <!-- Floating Highlight & Note Action Tooltip -->
    <div class="selection-tooltip" id="selection-tooltip" hidden>
      <button type="button" class="btn-sel-action" id="btn-create-annotation">
        <span aria-hidden="true">🖋️</span> Add Note / Highlight
      </button>
    </div>

    <!-- Annotation Composer Modal -->
    <div class="annotation-modal-backdrop" id="annotation-modal-backdrop" hidden>
      <div class="annotation-modal" id="annotation-modal" role="dialog" aria-labelledby="modal-title">
        <div class="modal-header">
          <h3 id="modal-title" class="modal-heading">Add Note to Selection</h3>
          <button type="button" class="modal-close-btn" id="modal-close-btn" aria-label="Close">&times;</button>
        </div>
        
        <div class="modal-body">
          <div class="quote-preview-box">
            <span class="quote-icon" aria-hidden="true">&ldquo;</span>
            <p class="quote-preview-text" id="modal-quote-text"></p>
          </div>

          <label for="modal-comment-input" class="field-label">Your Note / Analysis (Optional):</label>
          <textarea
            id="modal-comment-input"
            class="comment-textarea"
            rows="3"
            placeholder="Write a thought, note, or reaction to this passage..."
          ></textarea>

          <div class="color-picker-section">
            <span class="field-label">Highlight Tint:</span>
            <div class="color-options" id="color-options" role="radiogroup" aria-label="Highlight Color">
              <label class="color-option">
                <input type="radio" name="hl-color" value="cobalt" checked />
                <span class="color-swatch color-cobalt"></span> Cobalt
              </label>
              <label class="color-option">
                <input type="radio" name="hl-color" value="amber" />
                <span class="color-swatch color-amber"></span> Amber
              </label>
              <label class="color-option">
                <input type="radio" name="hl-color" value="sage" />
                <span class="color-swatch color-sage"></span> Sage
              </label>
              <label class="color-option">
                <input type="radio" name="hl-color" value="rose" />
                <span class="color-swatch color-rose"></span> Rose
              </label>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn-cancel" id="modal-cancel-btn">Cancel</button>
          <button type="button" class="btn-save-note" id="modal-save-btn">Save Note</button>
        </div>
      </div>
    </div>

    <!-- Annotation Inspector Popover (for viewing/editing a note) -->
    <div class="annotation-popover" id="annotation-popover" hidden>
      <div class="popover-header">
        <span class="popover-badge" id="popover-color-badge">Cobalt</span>
        <span class="popover-date" id="popover-date">Just now</span>
        <button type="button" class="popover-close-btn" id="popover-close-btn" aria-label="Close popover">&times;</button>
      </div>

      <div class="popover-body">
        <blockquote class="popover-quote" id="popover-quote"></blockquote>
        <div class="popover-comment" id="popover-comment"></div>
        <div class="popover-edit-area" id="popover-edit-area" hidden>
          <textarea id="popover-edit-input" class="comment-textarea" rows="3"></textarea>
        </div>
      </div>

      <div class="popover-footer">
        <div class="popover-view-actions" id="popover-view-actions">
          <button type="button" class="btn-pop-action" id="btn-edit-note">Edit</button>
          <button type="button" class="btn-pop-action btn-pop-delete" id="btn-delete-note">Delete</button>
        </div>
        <div class="popover-edit-actions" id="popover-edit-actions" hidden>
          <button type="button" class="btn-cancel" id="btn-cancel-edit-note">Cancel</button>
          <button type="button" class="btn-save-note" id="btn-save-edit-note">Save</button>
        </div>
      </div>
    </div>

    <!-- Annotations Slide-Over Drawer -->
    <aside class="annotations-drawer" id="annotations-drawer" hidden aria-label="Annotations and Notes">
      <div class="drawer-header">
        <div class="drawer-title-group">
          <h3 class="drawer-title">Story Notes &amp; Highlights</h3>
          <span class="drawer-counter" id="drawer-total-count">0 annotations</span>
        </div>
        <button type="button" class="drawer-close-btn" id="drawer-close-btn" aria-label="Close notes panel">&times;</button>
      </div>

      <div class="drawer-toolbar">
        <div class="drawer-filters" id="drawer-filters">
          <button type="button" class="filter-btn active" data-filter="all">All</button>
          <button type="button" class="filter-btn" data-filter="cobalt">Cobalt</button>
          <button type="button" class="filter-btn" data-filter="amber">Amber</button>
          <button type="button" class="filter-btn" data-filter="sage">Sage</button>
          <button type="button" class="filter-btn" data-filter="rose">Rose</button>
        </div>
      </div>

      <div class="drawer-content" id="drawer-notes-list">
        <!-- Dynamically rendered notes cards -->
      </div>

      <div class="drawer-footer">
        <button type="button" class="btn-drawer-action" id="btn-export-notes">Export as Markdown</button>
        <button type="button" class="btn-drawer-action btn-clear-all" id="btn-clear-all-notes">Clear All</button>
      </div>
    </aside>

    <div class="prose" id="story-prose">
      <Content />
    </div>

    {piece.data.status === 'in progress' && (
      <p class="wip">This piece is still being written. More to come.</p>
    )}

    <a class="back" href="/writing/">&#8592; All writing</a>
  </article>
</BaseLayout>

<script>
  // ============================================================
  // READING CONTROLLER: BOOKMARKING, CHAPTER NAVIGATION & ANNOTATIONS
  // ============================================================

  interface StoryAnnotation {
    id: string;
    slug: string;
    text: string;
    comment: string;
    color: 'cobalt' | 'amber' | 'sage' | 'rose';
    createdAt: number;
    chapterTitle?: string;
    anchor: {
      prefix: string;
      exact: string;
      suffix: string;
      paragraphIndex?: number;
    };
  }

  document.addEventListener('DOMContentLoaded', () => {
    const article = document.querySelector('.article') as HTMLElement | null;
    if (!article) return;

    const slug = article.dataset.slug || window.location.pathname.replace(/\/writing\/?|\//g, '');
    const bookmarkStorageKey = `story_bookmark_${slug}`;
    const annotationsStorageKey = `story_annotations_${slug}`;

    const prose = document.getElementById('story-prose') as HTMLElement | null;
    const progressBar = document.getElementById('reading-progress-bar');
    const resumeBanner = document.getElementById('resume-banner');
    const resumeHeading = document.getElementById('resume-heading');
    const resumePct = document.getElementById('resume-pct');
    const btnResume = document.getElementById('btn-resume');
    const btnClearBm = document.getElementById('btn-clear-bm');
    const readingToolbar = document.getElementById('reading-toolbar');
    const chapterMenuBtn = document.getElementById('chapter-menu-btn');
    const currentChapterTitle = document.getElementById('current-chapter-title');
    const chapterDropdown = document.getElementById('chapter-dropdown');
    const chapterList = document.getElementById('chapter-list');
    const chapterCount = document.getElementById('chapter-count');
    const readPctBadge = document.getElementById('read-pct-badge');
    const quickBmBtn = document.getElementById('quick-bm-btn');
    const quickBmText = document.getElementById('quick-bm-text');

    // Annotation Elements
    const selectionTooltip = document.getElementById('selection-tooltip');
    const btnCreateAnnotation = document.getElementById('btn-create-annotation');
    const annotationModalBackdrop = document.getElementById('annotation-modal-backdrop');
    const modalQuoteText = document.getElementById('modal-quote-text');
    const modalCommentInput = document.getElementById('modal-comment-input') as HTMLTextAreaElement | null;
    const modalCloseBtn = document.getElementById('modal-close-btn');
    const modalCancelBtn = document.getElementById('modal-cancel-btn');
    const modalSaveBtn = document.getElementById('modal-save-btn');
    const notesCountLabel = document.getElementById('notes-count-label');
    const openNotesBtn = document.getElementById('open-notes-btn');
    const annotationsDrawer = document.getElementById('annotations-drawer');
    const drawerCloseBtn = document.getElementById('drawer-close-btn');
    const drawerNotesList = document.getElementById('drawer-notes-list');
    const drawerTotalCount = document.getElementById('drawer-total-count');
    const drawerFilters = document.getElementById('drawer-filters');
    const btnExportNotes = document.getElementById('btn-export-notes');
    const btnClearAllNotes = document.getElementById('btn-clear-all-notes');

    // Popover Elements
    const annotationPopover = document.getElementById('annotation-popover');
    const popoverColorBadge = document.getElementById('popover-color-badge');
    const popoverDate = document.getElementById('popover-date');
    const popoverQuote = document.getElementById('popover-quote');
    const popoverComment = document.getElementById('popover-comment');
    const popoverCloseBtn = document.getElementById('popover-close-btn');
    const btnEditNote = document.getElementById('btn-edit-note');
    const btnDeleteNote = document.getElementById('btn-delete-note');
    const popoverEditArea = document.getElementById('popover-edit-area');
    const popoverEditInput = document.getElementById('popover-edit-input') as HTMLTextAreaElement | null;
    const popoverViewActions = document.getElementById('popover-view-actions');
    const popoverEditActions = document.getElementById('popover-edit-actions');
    const btnCancelEditNote = document.getElementById('btn-cancel-edit-note');
    const btnSaveEditNote = document.getElementById('btn-save-edit-note');

    if (!prose) return;

    let activeFilter = 'all';
    let currentInspectingAnnotationId: string | null = null;
    let pendingSelectionData: {
      text: string;
      prefix: string;
      suffix: string;
      paragraphIndex?: number;
    } | null = null;

    // ------------------------------------------------------------
    // 1. CHAPTER LIST & SCROLL SPY
    // ------------------------------------------------------------
    const headings = Array.from(prose.querySelectorAll('h2')) as HTMLHeadingElement[];
    
    if (headings.length > 0) {
      if (readingToolbar) readingToolbar.hidden = false;
      if (chapterCount) chapterCount.textContent = `${headings.length} sections`;

      if (chapterList) {
        chapterList.innerHTML = '';
        headings.forEach((h, idx) => {
          if (!h.id) {
            h.id = `section-${idx + 1}`;
          }
          const li = document.createElement('li');
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'chapter-item-btn';
          btn.dataset.targetId = h.id;
          btn.innerHTML = `<span class="ch-num">${idx + 1}.</span> <span class="ch-name">${h.textContent || ''}</span>`;

          btn.addEventListener('click', () => {
            scrollToHeading(h);
            closeDropdown();
          });

          li.appendChild(btn);
          chapterList.appendChild(li);
        });
      }
    }

    function toggleDropdown() {
      if (!chapterDropdown || !chapterMenuBtn) return;
      const isExpanded = chapterMenuBtn.getAttribute('aria-expanded') === 'true';
      chapterMenuBtn.setAttribute('aria-expanded', String(!isExpanded));
      chapterDropdown.hidden = isExpanded;
    }

    function closeDropdown() {
      if (!chapterDropdown || !chapterMenuBtn) return;
      chapterMenuBtn.setAttribute('aria-expanded', 'false');
      chapterDropdown.hidden = true;
    }

    if (chapterMenuBtn) {
      chapterMenuBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleDropdown();
      });
    }

    document.addEventListener('click', (e) => {
      if (chapterDropdown && !chapterDropdown.hidden) {
        if (!chapterDropdown.contains(e.target as Node) && e.target !== chapterMenuBtn) {
          closeDropdown();
        }
      }
    });

    function scrollToHeading(headingEl: HTMLElement) {
      const navOffset = 64;
      const elementPosition = headingEl.getBoundingClientRect().top;
      const offsetPosition = elementPosition + window.pageYOffset - navOffset;

      window.scrollTo({
        top: offsetPosition,
        behavior: 'smooth'
      });

      headingEl.classList.remove('highlight-pulse');
      void headingEl.offsetWidth;
      headingEl.classList.add('highlight-pulse');
      setTimeout(() => headingEl.classList.remove('highlight-pulse'), 2500);

      saveBookmarkState();
    }

    function getReadingProgress(): { pct: number; activeHeading: HTMLHeadingElement | null } {
      const scrollY = window.pageYOffset;
      const start = article!.offsetTop;
      const totalHeight = article!.offsetHeight;
      const viewportHeight = window.innerHeight;

      const maxScroll = Math.max(1, totalHeight - viewportHeight);
      const current = Math.max(0, scrollY - start);
      const pct = Math.min(100, Math.max(0, Math.round((current / maxScroll) * 100)));

      let activeHeading: HTMLHeadingElement | null = null;
      for (let i = headings.length - 1; i >= 0; i--) {
        const h = headings[i];
        const hTop = h.getBoundingClientRect().top;
        if (hTop <= 160) {
          activeHeading = h;
          break;
        }
      }
      if (!activeHeading && headings.length > 0) {
        activeHeading = headings[0];
      }

      return { pct, activeHeading };
    }

    function updateReadingUI() {
      const { pct, activeHeading } = getReadingProgress();

      if (progressBar) {
        progressBar.style.width = `${pct}%`;
      }
      if (readPctBadge) {
        readPctBadge.textContent = `${pct}% read`;
      }
      if (activeHeading && currentChapterTitle) {
        currentChapterTitle.textContent = activeHeading.textContent || 'Select chapter...';

        const items = chapterList?.querySelectorAll('.chapter-item-btn') || [];
        items.forEach((btn) => {
          if ((btn as HTMLElement).dataset.targetId === activeHeading!.id) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });
      }
    }

    function saveBookmarkState() {
      const { pct, activeHeading } = getReadingProgress();
      if (pct >= 99) {
        const data = {
          scrollY: window.pageYOffset,
          pct: 100,
          headingTitle: 'Finished',
          headingId: '',
          updatedAt: Date.now()
        };
        localStorage.setItem(bookmarkStorageKey, JSON.stringify(data));
        return;
      }

      if (pct >= 1) {
        const data = {
          scrollY: window.pageYOffset,
          pct,
          headingTitle: activeHeading?.textContent || '',
          headingId: activeHeading?.id || '',
          updatedAt: Date.now()
        };
        localStorage.setItem(bookmarkStorageKey, JSON.stringify(data));
      }
    }

    let scrollTimeout: number | undefined;
    window.addEventListener('scroll', () => {
      updateReadingUI();
      clearTimeout(scrollTimeout);
      scrollTimeout = window.setTimeout(() => {
        saveBookmarkState();
      }, 400);
    }, { passive: true });

    updateReadingUI();

    if (quickBmBtn) {
      quickBmBtn.addEventListener('click', () => {
        saveBookmarkState();
        if (quickBmText) {
          const orig = quickBmText.textContent;
          quickBmText.textContent = 'Saved!';
          setTimeout(() => {
            quickBmText.textContent = orig;
          }, 1800);
        }
      });
    }

    // Restore Bookmark
    try {
      const savedRaw = localStorage.getItem(bookmarkStorageKey);
      if (savedRaw) {
        const saved = JSON.parse(savedRaw);
        if (saved && typeof saved.pct === 'number' && saved.pct >= 2 && saved.pct < 98 && saved.scrollY > 150) {
          if (resumeBanner && resumeHeading && resumePct) {
            resumeHeading.textContent = saved.headingTitle || 'Saved point';
            resumePct.textContent = `(${saved.pct}% read)`;
            resumeBanner.hidden = false;

            if (btnResume) {
              btnResume.addEventListener('click', () => {
                window.scrollTo({
                  top: saved.scrollY,
                  behavior: 'smooth'
                });
                resumeBanner.hidden = true;
                
                if (saved.headingId) {
                  const targetEl = document.getElementById(saved.headingId);
                  if (targetEl) {
                    targetEl.classList.add('highlight-pulse');
                    setTimeout(() => targetEl.classList.remove('highlight-pulse'), 2500);
                  }
                }
              });
            }

            if (btnClearBm) {
              btnClearBm.addEventListener('click', () => {
                localStorage.removeItem(bookmarkStorageKey);
                resumeBanner.hidden = true;
              });
            }
          }
        }
      }
    } catch (e) {}

    // ------------------------------------------------------------
    // 2. ANNOTATION & HIGHLIGHT ENGINE (CSS Custom Highlights)
    // ------------------------------------------------------------

    function getStoredAnnotations(): StoryAnnotation[] {
      try {
        const raw = localStorage.getItem(annotationsStorageKey);
        return raw ? JSON.parse(raw) : [];
      } catch (e) {
        return [];
      }
    }

    function saveStoredAnnotations(items: StoryAnnotation[]) {
      try {
        localStorage.setItem(annotationsStorageKey, JSON.stringify(items));
        renderHighlights();
        updateDrawerNotesList();
        updateNotesBadge();
      } catch (e) {}
    }

    function updateNotesBadge() {
      const items = getStoredAnnotations();
      if (notesCountLabel) {
        notesCountLabel.textContent = `Notes (${items.length})`;
      }
      if (drawerTotalCount) {
        drawerTotalCount.textContent = `${items.length} annotation${items.length === 1 ? '' : 's'}`;
      }
    }

    function getAllTextNodes(): Text[] {
      if (!prose) return [];
      const walker = document.createTreeWalker(prose, NodeFilter.SHOW_TEXT);
      const nodes: Text[] = [];
      let n = walker.nextNode();
      while (n) {
        nodes.push(n as Text);
        n = walker.nextNode();
      }
      return nodes;
    }

    function findRangesForAnnotation(ann: StoryAnnotation, textNodes: Text[]): Range[] {
      const ranges: Range[] = [];
      const searchText = ann.text.trim();
      if (!searchText) return ranges;

      const fullDocText = textNodes.map((n) => n.textContent || '').join('');
      let searchIndex = fullDocText.indexOf(searchText);

      if (searchIndex === -1 && ann.anchor.prefix) {
        const combined = (ann.anchor.prefix + searchText).slice(-searchText.length);
        searchIndex = fullDocText.indexOf(combined);
      }

      if (searchIndex !== -1) {
        let currentPos = 0;
        let startNode: Text | null = null;
        let startOffset = 0;
        let endNode: Text | null = null;
        let endOffset = 0;
        const targetEnd = searchIndex + searchText.length;

        for (const node of textNodes) {
          const len = (node.textContent || '').length;
          const nodeStart = currentPos;
          const nodeEnd = currentPos + len;

          if (!startNode && searchIndex >= nodeStart && searchIndex < nodeEnd) {
            startNode = node;
            startOffset = searchIndex - nodeStart;
          }

          if (startNode && targetEnd > nodeStart && targetEnd <= nodeEnd) {
            endNode = node;
            endOffset = targetEnd - nodeStart;
            break;
          }

          currentPos += len;
        }

        if (startNode && endNode) {
          try {
            const range = new Range();
            range.setStart(startNode, startOffset);
            range.setEnd(endNode, endOffset);
            ranges.push(range);
          } catch (e) {}
        }
      }

      return ranges;
    }

    function renderHighlights() {
      const annotations = getStoredAnnotations();
      const textNodes = getAllTextNodes();

      const colorRanges: Record<string, Range[]> = {
        cobalt: [],
        amber: [],
        sage: [],
        rose: []
      };

      prose?.querySelectorAll('.margin-note-badge').forEach((el) => el.remove());

      const paragraphNoteCount = new Map<HTMLElement, StoryAnnotation[]>();

      annotations.forEach((ann) => {
        const ranges = findRangesForAnnotation(ann, textNodes);
        if (ranges.length > 0) {
          colorRanges[ann.color]?.push(...ranges);

          const startContainer = ranges[0].startContainer;
          const parentBlock = (startContainer instanceof HTMLElement ? startContainer : startContainer.parentElement)?.closest('p, blockquote, li, h2, h3') as HTMLElement | null;
          if (parentBlock) {
            const existing = paragraphNoteCount.get(parentBlock) || [];
            existing.push(ann);
            paragraphNoteCount.set(parentBlock, existing);
          }
        }
      });

      if (typeof CSS !== 'undefined' && 'highlights' in CSS) {
        try {
          const HighlightConstructor = (window as any).Highlight;
          if (HighlightConstructor) {
            ['cobalt', 'amber', 'sage', 'rose'].forEach((c) => {
              const ranges = colorRanges[c] || [];
              if (ranges.length > 0) {
                const hl = new HighlightConstructor(...ranges);
                (CSS as any).highlights.set(`hl-${c}`, hl);
              } else {
                (CSS as any).highlights.delete(`hl-${c}`);
              }
            });
          }
        } catch (e) {}
      }

      paragraphNoteCount.forEach((notes, blockEl) => {
        blockEl.style.position = 'relative';
        const badge = document.createElement('button');
        badge.type = 'button';
        badge.className = 'margin-note-badge';
        badge.title = `${notes.length} note${notes.length === 1 ? '' : 's'} on this paragraph. Click to view.`;
        badge.innerHTML = `<span aria-hidden="true">💬</span> <span class="note-pill-num">${notes.length}</span>`;

        badge.addEventListener('click', (e) => {
          e.stopPropagation();
          openPopoverForAnnotation(notes[0], badge);
        });

        blockEl.appendChild(badge);
      });
    }

    // ------------------------------------------------------------
    // 3. TEXT SELECTION & ANNOTATION CREATION
    // ------------------------------------------------------------

    function handleSelectionChange() {
      const sel = window.getSelection();
      if (!sel || sel.isCollapsed || !prose) {
        hideSelectionTooltip();
        return;
      }

      const text = sel.toString().trim();
      if (text.length < 2) {
        hideSelectionTooltip();
        return;
      }

      const range = sel.getRangeAt(0);
      if (!prose.contains(range.commonAncestorContainer)) {
        hideSelectionTooltip();
        return;
      }

      const rect = range.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;

      const fullText = prose.textContent || '';
      const exact = text;
      const idx = fullText.indexOf(exact);
      const prefix = idx !== -1 ? fullText.slice(Math.max(0, idx - 32), idx) : '';
      const suffix = idx !== -1 ? fullText.slice(idx + exact.length, idx + exact.length + 32) : '';

      pendingSelectionData = {
        text: exact,
        prefix,
        suffix
      };

      showSelectionTooltip(rect);
    }

    function showSelectionTooltip(rect: DOMRect) {
      if (!selectionTooltip) return;
      selectionTooltip.hidden = false;
      const scrollX = window.pageXOffset;
      const scrollY = window.pageYOffset;

      const top = rect.top + scrollY - 42;
      const left = Math.max(10, rect.left + scrollX + rect.width / 2 - 80);

      selectionTooltip.style.top = `${top}px`;
      selectionTooltip.style.left = `${left}px`;
    }

    function hideSelectionTooltip() {
      if (selectionTooltip) selectionTooltip.hidden = true;
    }

    document.addEventListener('mouseup', () => {
      setTimeout(handleSelectionChange, 10);
    });
    document.addEventListener('keyup', (e) => {
      if (e.key === 'Shift' || e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        setTimeout(handleSelectionChange, 10);
      }
    });

    // Open Annotation Composer Modal
    if (btnCreateAnnotation) {
      btnCreateAnnotation.addEventListener('click', (e) => {
        e.stopPropagation();
        if (!pendingSelectionData) return;

        if (modalQuoteText) {
          modalQuoteText.textContent = pendingSelectionData.text;
        }
        if (modalCommentInput) {
          modalCommentInput.value = '';
        }
        if (annotationModalBackdrop) {
          annotationModalBackdrop.hidden = false;
          modalCommentInput?.focus();
        }
        hideSelectionTooltip();
      });
    }

    function closeModal() {
      if (annotationModalBackdrop) annotationModalBackdrop.hidden = true;
      pendingSelectionData = null;
    }

    if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
    if (modalCancelBtn) modalCancelBtn.addEventListener('click', closeModal);
    
    // Close modal on backdrop click
    if (annotationModalBackdrop) {
      annotationModalBackdrop.addEventListener('click', (e) => {
        if (e.target === annotationModalBackdrop) {
          closeModal();
        }
      });
    }

    if (modalSaveBtn) {
      modalSaveBtn.addEventListener('click', () => {
        if (!pendingSelectionData) return;

        const colorInput = document.querySelector('input[name="hl-color"]:checked') as HTMLInputElement | null;
        const color = (colorInput?.value as StoryAnnotation['color']) || 'cobalt';
        const comment = modalCommentInput?.value.trim() || '';

        const { activeHeading } = getReadingProgress();
        const newAnnotation: StoryAnnotation = {
          id: `ann_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`,
          slug,
          text: pendingSelectionData.text,
          comment,
          color,
          createdAt: Date.now(),
          chapterTitle: activeHeading?.textContent || '',
          anchor: {
            prefix: pendingSelectionData.prefix,
            exact: pendingSelectionData.text,
            suffix: pendingSelectionData.suffix
          }
        };

        const existing = getStoredAnnotations();
        existing.push(newAnnotation);
        saveStoredAnnotations(existing);

        window.getSelection()?.removeAllRanges();
        closeModal();
      });
    }

    // ------------------------------------------------------------
    // 4. ANNOTATION POPOVER (INSPECTOR / EDIT / DELETE)
    // ------------------------------------------------------------

    function openPopoverForAnnotation(ann: StoryAnnotation, anchorEl?: HTMLElement) {
      if (!annotationPopover) return;
      currentInspectingAnnotationId = ann.id;

      if (popoverColorBadge) {
        popoverColorBadge.textContent = ann.color.toUpperCase();
        popoverColorBadge.className = `popover-badge badge-${ann.color}`;
      }
      if (popoverDate) {
        const d = new Date(ann.createdAt);
        popoverDate.textContent = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
      }
      if (popoverQuote) {
        popoverQuote.textContent = `“${ann.text}”`;
      }
      if (popoverComment) {
        popoverComment.textContent = ann.comment || '(No note written — highlight only)';
        popoverComment.hidden = false;
      }
      if (popoverEditArea) popoverEditArea.hidden = true;
      if (popoverViewActions) popoverViewActions.hidden = false;
      if (popoverEditActions) popoverEditActions.hidden = true;

      annotationPopover.hidden = false;

      if (anchorEl) {
        const rect = anchorEl.getBoundingClientRect();
        const top = rect.bottom + window.pageYOffset + 8;
        const left = Math.min(window.innerWidth - 340, Math.max(16, rect.left + window.pageXOffset - 120));
        annotationPopover.style.top = `${top}px`;
        annotationPopover.style.left = `${left}px`;
      } else {
        annotationPopover.style.top = `${window.pageYOffset + 120}px`;
        annotationPopover.style.left = '50%';
        annotationPopover.style.transform = 'translateX(-50%)';
      }
    }

    function closePopover() {
      if (annotationPopover) annotationPopover.hidden = true;
      currentInspectingAnnotationId = null;
    }

    if (popoverCloseBtn) popoverCloseBtn.addEventListener('click', closePopover);

    if (btnEditNote) {
      btnEditNote.addEventListener('click', () => {
        const ann = getStoredAnnotations().find((a) => a.id === currentInspectingAnnotationId);
        if (!ann) return;

        if (popoverComment) popoverComment.hidden = true;
        if (popoverEditArea) popoverEditArea.hidden = false;
        if (popoverEditInput) {
          popoverEditInput.value = ann.comment || '';
          popoverEditInput.focus();
        }
        if (popoverViewActions) popoverViewActions.hidden = true;
        if (popoverEditActions) popoverEditActions.hidden = false;
      });
    }

    if (btnCancelEditNote) {
      btnCancelEditNote.addEventListener('click', () => {
        if (popoverComment) popoverComment.hidden = false;
        if (popoverEditArea) popoverEditArea.hidden = true;
        if (popoverViewActions) popoverViewActions.hidden = false;
        if (popoverEditActions) popoverEditActions.hidden = true;
      });
    }

    if (btnSaveEditNote) {
      btnSaveEditNote.addEventListener('click', () => {
        const all = getStoredAnnotations();
        const idx = all.findIndex((a) => a.id === currentInspectingAnnotationId);
        if (idx !== -1 && popoverEditInput) {
          all[idx].comment = popoverEditInput.value.trim();
          saveStoredAnnotations(all);
          openPopoverForAnnotation(all[idx]);
        }
      });
    }

    if (btnDeleteNote) {
      btnDeleteNote.addEventListener('click', () => {
        if (!currentInspectingAnnotationId) return;
        const all = getStoredAnnotations().filter((a) => a.id !== currentInspectingAnnotationId);
        saveStoredAnnotations(all);
        closePopover();
      });
    }

    // ------------------------------------------------------------
    // 5. ANNOTATIONS DRAWER & EXPORT
    // ------------------------------------------------------------

    function updateDrawerNotesList() {
      if (!drawerNotesList) return;
      const all = getStoredAnnotations();
      const filtered = activeFilter === 'all' ? all : all.filter((a) => a.color === activeFilter);

      drawerNotesList.innerHTML = '';

      if (filtered.length === 0) {
        drawerNotesList.innerHTML = `
          <div class="drawer-empty-state">
            <p>No notes ${activeFilter === 'all' ? 'yet' : 'in this color'}.</p>
            <p class="empty-sub">Highlight any text in the story to create your first note.</p>
          </div>
        `;
        return;
      }

      filtered.forEach((ann) => {
        const card = document.createElement('div');
        card.className = `note-card note-card-${ann.color}`;
        
        const d = new Date(ann.createdAt);
        const dateStr = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

        card.innerHTML = `
          <div class="note-card-meta">
            <span class="note-card-chapter">${ann.chapterTitle || 'Passage'}</span>
            <span class="note-card-date">${dateStr}</span>
          </div>
          <blockquote class="note-card-quote">&ldquo;${ann.text}&rdquo;</blockquote>
          ${ann.comment ? `<p class="note-card-comment">${ann.comment}</p>` : ''}
          <div class="note-card-actions">
            <button type="button" class="btn-card-jump" data-id="${ann.id}">Jump to text &rarr;</button>
            <button type="button" class="btn-card-delete" data-id="${ann.id}" title="Delete note">&times;</button>
          </div>
        `;

        card.querySelector('.btn-card-jump')?.addEventListener('click', () => {
          jumpToAnnotation(ann);
          if (window.innerWidth < 768) {
            closeDrawer();
          }
        });

        card.querySelector('.btn-card-delete')?.addEventListener('click', (e) => {
          e.stopPropagation();
          const remaining = getStoredAnnotations().filter((a) => a.id !== ann.id);
          saveStoredAnnotations(remaining);
        });

        drawerNotesList.appendChild(card);
      });
    }

    function jumpToAnnotation(ann: StoryAnnotation) {
      const textNodes = getAllTextNodes();
      const ranges = findRangesForAnnotation(ann, textNodes);
      if (ranges.length > 0) {
        const startNode = ranges[0].startContainer;
        const targetEl = (startNode instanceof HTMLElement ? startNode : startNode.parentElement) as HTMLElement | null;
        if (targetEl) {
          const offsetTop = targetEl.getBoundingClientRect().top + window.pageYOffset - 80;
          window.scrollTo({
            top: offsetTop,
            behavior: 'smooth'
          });

          targetEl.classList.remove('highlight-pulse');
          void targetEl.offsetWidth;
          targetEl.classList.add('highlight-pulse');
          setTimeout(() => targetEl.classList.remove('highlight-pulse'), 2500);

          openPopoverForAnnotation(ann, targetEl);
        }
      }
    }

    function openDrawer() {
      if (annotationsDrawer) {
        updateDrawerNotesList();
        annotationsDrawer.hidden = false;
      }
    }

    function closeDrawer() {
      if (annotationsDrawer) annotationsDrawer.hidden = true;
    }

    if (openNotesBtn) openNotesBtn.addEventListener('click', openDrawer);
    if (drawerCloseBtn) drawerCloseBtn.addEventListener('click', closeDrawer);

    // Drawer Color Filter Pills
    drawerFilters?.querySelectorAll('.filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        drawerFilters.querySelectorAll('.filter-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeFilter = (btn as HTMLElement).dataset.filter || 'all';
        updateDrawerNotesList();
      });
    });

    // Export as Markdown
    if (btnExportNotes) {
      btnExportNotes.addEventListener('click', () => {
        const notes = getStoredAnnotations();
        if (notes.length === 0) {
          alert('No annotations to export.');
          return;
        }

        const title = document.querySelector('h1.title')?.textContent || 'Story';
        let md = `# Notes & Highlights: ${title}\n\n`;
        md += `*Exported on ${new Date().toLocaleDateString()}*\n\n---\n\n`;

        notes.forEach((n, i) => {
          md += `### ${i + 1}. ${n.chapterTitle || 'Passage'}\n\n`;
          md += `> "${n.text}"\n\n`;
          if (n.comment) {
            md += `**Note**: ${n.comment}\n\n`;
          }
          md += `*Color: ${n.color.toUpperCase()} · ${new Date(n.createdAt).toLocaleDateString()}*\n\n---\n\n`;
        });

        navigator.clipboard.writeText(md).then(() => {
          const orig = btnExportNotes.textContent;
          btnExportNotes.textContent = 'Copied Markdown!';
          setTimeout(() => {
            btnExportNotes.textContent = orig;
          }, 2000);
        }).catch(() => {
          const blob = new Blob([md], { type: 'text/markdown' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `${slug}-notes.md`;
          a.click();
          URL.revokeObjectURL(url);
        });
      });
    }

    // Clear All
    if (btnClearAllNotes) {
      btnClearAllNotes.addEventListener('click', () => {
        if (confirm('Are you sure you want to delete all notes and highlights for this story?')) {
          saveStoredAnnotations([]);
          closePopover();
        }
      });
    }

    // Global keyboard listener (Escape to close any modal/drawer/popover)
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeModal();
        closePopover();
        closeDrawer();
        closeDropdown();
        hideSelectionTooltip();
      }
    });

    // Initial render of highlights & notes
    renderHighlights();
    updateNotesBadge();
  });
</script>

